msgstr "La désactivation de ce module le retirera de :\n{0}"

msgctxt "#32747"
msgid "Provider module unavailable"
msgstr "Module de fournisseur indisponible"

msgctxt "#32748"
msgid "The {0} module could not be loaded and its features are temporarily unavailable. Update the module to the latest version and try again. Your settings and synced data have been kept."
msgstr "Le module {0} n'a pas pu être chargé et ses fonctionnalités sont temporairement indisponibles. Mettez le module à jour vers la dernière version et réessayez. Vos paramètres et vos données synchronisées ont été conservés."

