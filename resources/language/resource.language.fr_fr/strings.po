msgid "Order ratings providers from highest to lowest priority. Existing cached ratings are retained."
msgstr "Classez les fournisseurs de notes de la priorité la plus haute à la plus basse. Les notes déjà mises en cache sont conservées."

msgctxt "#32593"
msgid "Episode numbering"
msgstr "Numérotation des épisodes"

msgctxt "#32594"
msgid "Default"
msgstr "Par défaut"

msgctxt "#32595"
msgid "Select"
msgstr "Sélectionner"

msgctxt "#32596"
msgid "Group"
msgstr "Groupe"

msgctxt "#32597"
msgid "Use TMDb numbers, ask for a group, or use the current group. Individual players can override this choice."
msgstr "Utilise la numérotation TMDb, demande un groupe ou utilise le groupe actuel. Chaque lecteur peut remplacer ce choix."

msgctxt "#32598"
msgid "Statistics"
msgstr "Statistiques"

msgctxt "#32599"
msgid "Choose providers to receive playback activity. Clear all selections to disable scrobbling."
msgstr "Choisissez les fournisseurs qui recevront l'activité de lecture. Désélectionnez tout pour désactiver le scrobbling."

msgctxt "#32600"
msgid "Currently Watching"
msgstr "En cours de visionnage"

msgctxt "#32602"
msgid "Your Next Movies"
msgstr "Vos prochains films"

msgctxt "#32603"
msgid "Update collections"
msgstr "Mettre à jour les collections"

msgctxt "#32604"
msgid "Discover new movie collections daily and refresh older ones for Your Next Movies after its first use."
msgstr "Découvre chaque jour de nouvelles collections de films et actualise les plus anciennes pour « Vos prochains films » après sa première utilisation."

msgctxt "#32605"
msgid "Daily request limit"
msgstr "Limite quotidienne de requêtes"

msgctxt "#32606"
msgid "Limit daily movie collection requests, including retries. New collections take priority over overdue refreshes."
msgstr "Limite les requêtes quotidiennes de collections de films, nouvelles tentatives comprises. Les nouvelles collections sont prioritaires sur les actualisations en retard."

msgctxt "#32607"
msgid "Drop collection"
msgstr "Abandonner la collection"

msgctxt "#32608"
msgid "Advanced"
msgstr "Avancé"

msgctxt "#32609"
msgid "Include movie releases outside your selected country when filtering TMDb lists."
msgstr "Inclut les sorties de films hors de votre pays sélectionné lors du filtrage des listes TMDb."

msgctxt "#32610"
msgid "Show authorisation and sync notifications when Kodi starts."
msgstr "Affiche les notifications d'autorisation et de synchronisation au démarrage de Kodi."

msgctxt "#32611"
msgid "Show notifications while user data is synchronising."
msgstr "Affiche des notifications pendant la synchronisation des données utilisateur."

msgctxt "#32612"
msgid "Show a notification when a service connection fails."
msgstr "Affiche une notification lorsqu'une connexion à un service échoue."

msgctxt "#32613"
msgid "Show Browse lists in the item context menu."
msgstr "Affiche « Parcourir les listes » dans le menu contextuel de l'élément."

msgctxt "#32614"
msgid "Show sync actions in the item context menu."
msgstr "Affiche les actions de synchronisation dans le menu contextuel de l'élément."

msgctxt "#32615"
msgid "Show TMDb account actions in the item context menu."
msgstr "Affiche les actions du compte TMDb dans le menu contextuel de l'élément."

msgctxt "#32616"
msgid "Show Refresh details in the item context menu."
msgstr "Affiche « Actualiser les détails » dans le menu contextuel de l'élément."

msgctxt "#32617"
msgid "Show Modify artwork in the item context menu."
msgstr "Affiche « Modifier l'illustration » dans le menu contextuel de l'élément."

msgctxt "#32618"
msgid "Add to library"
msgstr "Ajouter à la médiathèque"

msgctxt "#32619"
msgid "Show Add to library in the item context menu."
msgstr "Affiche « Ajouter à la médiathèque » dans le menu contextuel de l'élément."

msgctxt "#32620"
msgid "Show Add node in the item context menu."
msgstr "Affiche « Ajouter un nœud » dans le menu contextuel de l'élément."

msgctxt "#32621"
msgid "Show a next-page item in widgets when more results are available."
msgstr "Affiche un élément « page suivante » dans les widgets lorsque d'autres résultats sont disponibles."

msgctxt "#32622"
msgid "Open the episode list directly instead of showing seasons."
msgstr "Ouvre directement la liste des épisodes au lieu d'afficher les saisons."

msgctxt "#32623"
msgid "Show the additional Specials season entry."
msgstr "Affiche l'entrée supplémentaire de la saison Spéciaux."

msgctxt "#32624"
msgid "Show the additional Anticipated season entry."
msgstr "Affiche l'entrée supplémentaire de la saison Attendus."

msgctxt "#32625"
msgid "Show the additional episode Groups entry."
msgstr "Affiche l'entrée supplémentaire des groupes d'épisodes."

msgctxt "#32626"
msgid "Show the additional Up next season entry when signed in to Trakt."
msgstr "Affiche l'entrée supplémentaire « À suivre » lorsque vous êtes connecté à Trakt."

msgctxt "#32627"
msgid "Combine episodes from the same show airing on the same day into one calendar entry."
msgstr "Regroupe en une seule entrée de calendrier les épisodes d'une même série diffusés le même jour."

msgctxt "#32628"
msgid "Open the local TV show from entries in the next-aired library calendar."
msgstr "Ouvre la série TV locale depuis les entrées du calendrier des prochaines diffusions de la médiathèque."

msgctxt "#32629"
msgid "Choose the artwork used for next-episode thumbnails."
msgstr "Choisissez l'illustration utilisée pour les vignettes des prochains épisodes."

msgctxt "#32630"
msgid "Check the calendar for next episodes. Slower, but more accurate."
msgstr "Vérifie le calendrier pour les prochains épisodes. Plus lent, mais plus précis."

msgctxt "#32631"
msgid "Load this many pages per request for basic TMDb lists. Higher values are slower."
msgstr "Charge ce nombre de pages par requête pour les listes TMDb de base. Les valeurs élevées sont plus lentes."

msgctxt "#32632"
msgid "Load this many pages per request for other basic lists. Higher values are slower."
msgstr "Charge ce nombre de pages par requête pour les autres listes de base. Les valeurs élevées sont plus lentes."

msgctxt "#32633"
msgid "Load this many pages per request for synced database lists. Higher values are slower."
msgstr "Charge ce nombre de pages par requête pour les listes de la base de données synchronisée. Les valeurs élevées sont plus lentes."

msgctxt "#32634"
msgid "Cache the items in Trakt custom lists you own for 24 hours."
msgstr "Met en cache pendant 24 heures les éléments de vos listes personnalisées Trakt."

msgctxt "#32635"
msgid "Choose the default resolution of artwork downloaded from TMDb. Poster and fanart settings can override this default."
msgstr "Choisissez la résolution par défaut des illustrations téléchargées depuis TMDb. Les paramètres des affiches et des fanarts peuvent remplacer cette valeur."

msgctxt "#32636"
msgid "Fetch Fanart.tv artwork for plugin items. Additional lookups are slower."
msgstr "Récupère les illustrations Fanart.tv pour les éléments de l'extension. Les recherches supplémentaires sont plus lentes."

msgctxt "#32637"
msgid "Prefer Fanart.tv artwork over TMDb artwork when both are available."
msgstr "Préfère les illustrations Fanart.tv à celles de TMDb lorsque les deux sont disponibles."

msgctxt "#32638"
msgid "Prefer artwork in your selected language when choosing images."
msgstr "Préfère les illustrations dans la langue sélectionnée lors du choix des images."

msgctxt "#32639"
msgid "Choose the folder containing custom icons for TMDb genres."
msgstr "Choisissez le dossier contenant les icônes personnalisées des genres TMDb."

msgctxt "#32640"
msgid "Choose the folder containing custom icons for Trakt genres."
msgstr "Choisissez le dossier contenant les icônes personnalisées des genres Trakt."

msgctxt "#32641"
msgid "Choose the folder containing custom TMDb watch-provider icons."
msgstr "Choisissez le dossier contenant les icônes personnalisées des fournisseurs de visionnage TMDb."

msgctxt "#32642"
msgid "Retrieve background artwork for genre entries."
msgstr "Récupère les illustrations d'arrière-plan pour les entrées de genres."

msgctxt "#32643"
msgid "Retrieve background artwork for watch-provider entries."
msgstr "Récupère les illustrations d'arrière-plan pour les entrées de fournisseurs de visionnage."

msgctxt "#32644"
msgid "Choose the default player used for movies."
msgstr "Choisissez le lecteur par défaut utilisé pour les films."

msgctxt "#32645"
msgid "Choose the default player used for TV episodes."
msgstr "Choisissez le lecteur par défaut utilisé pour les épisodes de séries TV."

msgctxt "#32646"
msgid "Automatically play using available providers instead of asking for a player."
msgstr "Lance automatiquement la lecture avec les fournisseurs disponibles au lieu de demander un lecteur."

msgctxt "#32647"
msgid "Choose how playback uses files already in the Kodi library."
msgstr "Choisissez comment la lecture utilise les fichiers déjà présents dans la médiathèque Kodi."

msgctxt "#32648"
msgid "Show one player entry per plugin instead of separate entries for each player."
msgstr "Affiche une seule entrée de lecteur par extension au lieu d'entrées séparées pour chaque lecteur."

msgctxt "#32649"
msgid "Include player definitions supplied with the add-on."
msgstr "Inclut les définitions de lecteurs fournies avec l'extension."

msgctxt "#32650"
msgid "Download player definitions from the URL you provide."
msgstr "Télécharge les définitions de lecteurs depuis l'URL que vous indiquez."

msgctxt "#32651"
msgid "Choose and customise the available player definitions."
msgstr "Choisissez et personnalisez les définitions de lecteurs disponibles."

msgctxt "#32652"
msgid "Ask for a TMDb rating after watching an item when signed in to TMDb."
msgstr "Demande une note TMDb après le visionnage d'un élément lorsque vous êtes connecté à TMDb."

msgctxt "#32653"
msgid "Movies folder"
msgstr "Dossier des films"

msgctxt "#32654"
msgid "Choose where movie STRM and NFO files are created for the Kodi library."
msgstr "Choisissez où sont créés les fichiers STRM et NFO des films pour la médiathèque Kodi."

msgctxt "#32655"
msgid "Choose where TV show STRM and NFO files are created for the Kodi library."
msgstr "Choisissez où sont créés les fichiers STRM et NFO des séries TV pour la médiathèque Kodi."

msgctxt "#32656"
msgid "Scan the Kodi library after adding items through TMDbHelper."
msgstr "Analyse la médiathèque Kodi après l'ajout d'éléments via TMDbHelper."

msgctxt "#32657"
msgid "Automatically update library exports and add new or missing episodes."
msgstr "Met à jour automatiquement les exports de la médiathèque et ajoute les épisodes nouveaux ou manquants."

msgctxt "#32658"
msgid "Choose the hour for the daily library update."
msgstr "Choisissez l'heure de la mise à jour quotidienne de la médiathèque."

msgctxt "#32659"
msgid "Choose the lists used to add items during automatic library updates."
msgstr "Choisissez les listes utilisées pour ajouter des éléments lors des mises à jour automatiques de la médiathèque."

msgctxt "#32660"
msgid "Store the source-list identifiers used by automatic library updates."
msgstr "Stocke les identifiants des listes sources utilisés par les mises à jour automatiques de la médiathèque."

msgctxt "#32661"
msgid "Choose which library exports to update now."
msgstr "Choisissez les exports de la médiathèque à mettre à jour maintenant."

msgctxt "#32662"
msgid "Choose whether to add local Kodi library details to items."
msgstr "Choisissez s'il faut ajouter aux éléments les détails de la médiathèque Kodi locale."

msgctxt "#32663"
msgid "Refresh TMDbHelper's cached details from the local Kodi library."
msgstr "Actualise les détails mis en cache par TMDbHelper à partir de la médiathèque Kodi locale."

msgctxt "#32664"
msgid "Skip checks after creating library folders on systems that report new folders slowly."
msgstr "Ignore les vérifications après la création des dossiers de la médiathèque sur les systèmes qui signalent lentement les nouveaux dossiers."

msgctxt "#32665"
msgid "Use movie-tmdbhelper.nfo or tvshow-tmdbhelper.nfo instead of the standard NFO filename."
msgstr "Utilise movie-tmdbhelper.nfo ou tvshow-tmdbhelper.nfo au lieu du nom de fichier NFO standard."

msgctxt "#32666"
msgid "Connect your Trakt account to TMDbHelper."
msgstr "Connecte votre compte Trakt à TMDbHelper."

msgctxt "#32667"
msgid "Disconnect your Trakt account from TMDbHelper."
msgstr "Déconnecte votre compte Trakt de TMDbHelper."

msgctxt "#32668"
msgid "Open settings"
msgstr "Ouvrir les paramètres"

msgctxt "#32669"
msgid "Install MDbList support if needed, then open its provider settings."
msgstr "Installe la prise en charge de MDbList si nécessaire, puis ouvre les paramètres de son fournisseur."

msgctxt "#32671"
msgid "Enter your OMDb API key for additional ratings and metadata."
msgstr "Saisissez votre clé API OMDb pour obtenir des notes et métadonnées supplémentaires."

msgctxt "#32672"
msgid "Enter your RatingPosterDB API key for posters with ratings."
msgstr "Saisissez votre clé API RatingPosterDB pour obtenir des affiches avec notes."

msgctxt "#32674"
msgid "Enter your Fanart.tv client key for artwork lookups."
msgstr "Saisissez votre clé client Fanart.tv pour la recherche d'illustrations."

msgctxt "#32675"
msgid "Configure providers"
msgstr "Configurer les fournisseurs"

msgctxt "#32676"
msgid "Store the selected ratings providers and their priority order."
msgstr "Stocke les fournisseurs de notes sélectionnés et leur ordre de priorité."

msgctxt "#32677"
msgid "Choose a watchlist provider, install one, or select None to disable watchlist lists."
msgstr "Choisissez un fournisseur de liste de suivi, installez-en un ou sélectionnez Aucun pour désactiver les listes de suivi."

msgctxt "#32678"
msgid "Choose a collection provider, install one, or select None to disable collection lists."
msgstr "Choisissez un fournisseur de collection, installez-en un ou sélectionnez Aucun pour désactiver les listes de collection."

msgctxt "#32679"
msgid "Choose a statistics provider, install one, or select None to disable statistics lists."
msgstr "Choisissez un fournisseur de statistiques, installez-en un ou sélectionnez Aucun pour désactiver les listes de statistiques."

msgctxt "#32680"
msgid "Choose a supported sync provider to install or enable."
msgstr "Choisissez un fournisseur de synchronisation pris en charge à installer ou à activer."

msgctxt "#32681"
msgid "Synchronise watched status and resume points with the selected history provider."
msgstr "Synchronise l'état « vu » et les points de reprise avec le fournisseur d'historique sélectionné."

msgctxt "#32682"
msgid "Clear cached synced user data so it can be downloaded again."
msgstr "Efface les données utilisateur synchronisées mises en cache afin qu'elles puissent être téléchargées à nouveau."

msgctxt "#32683"
msgid "Choose which watch providers are included in provider data lookups."
msgstr "Choisissez les fournisseurs de visionnage inclus dans les recherches de données des fournisseurs."

msgctxt "#32684"
msgid "Allow the image monitor to fetch artwork from online sources."
msgstr "Autorise le moniteur d'images à récupérer des illustrations depuis des sources en ligne."

msgctxt "#32685"
msgid "Allow the details monitor to fetch ratings from online sources."
msgstr "Autorise le moniteur de détails à récupérer des notes depuis des sources en ligne."

msgctxt "#32686"
msgid "Use TMDbHelper artwork instead of the clearlogo supplied by the playback monitor."
msgstr "Utilise les illustrations de TMDbHelper au lieu du clearlogo fourni par le moniteur de lecture."

msgctxt "#32687"
msgid "Set how long the dummy video plays when resolving playback, in seconds."
msgstr "Définit la durée de lecture de la vidéo factice lors de la résolution de la lecture, en secondes."

msgctxt "#32688"
msgid "Set the delay after the dummy video stops before playback continues, in seconds."
msgstr "Définit le délai, en secondes, entre l'arrêt de la vidéo factice et la reprise de la lecture."

msgctxt "#32689"
msgid "Restrict URL resolving to library STRM playback."
msgstr "Limite la résolution d'URL à la lecture des STRM de la médiathèque."

msgctxt "#32690"
msgid "Refresh cached Kodi library details when building the player list."
msgstr "Actualise les détails mis en cache de la médiathèque Kodi lors de la construction de la liste des lecteurs."

msgctxt "#32691"
msgid "Use the alternative TMDb API address for network compatibility."
msgstr "Utilise l'adresse API TMDb alternative pour la compatibilité réseau."

msgctxt "#32692"
msgid "Set the maximum number of concurrent threads. Zero means unlimited."
msgstr "Définit le nombre maximal de threads simultanés. Zéro signifie illimité."

msgctxt "#32693"
msgid "Choose a custom location for TMDbHelper cache databases."
msgstr "Choisissez un emplacement personnalisé pour les bases de données de cache de TMDbHelper."

msgctxt "#32694"
msgid "Choose a custom location for cached images."
msgstr "Choisissez un emplacement personnalisé pour les images en cache."

msgctxt "#32695"
msgid "Delete cached TMDb list details for troubleshooting. Lists will be downloaded again when needed."
msgstr "Supprime les détails des listes TMDb mis en cache pour le dépannage. Les listes seront téléchargées à nouveau si nécessaire."

msgctxt "#32696"
msgid "Write additional diagnostic information to the Kodi log."
msgstr "Écrit des informations de diagnostic supplémentaires dans le journal de Kodi."

msgctxt "#32697"
msgid "Disabled collects no timer reports. Basic collects directory timer reports. Detailed also collects item detail timer reports."
msgstr "« Désactivé » ne collecte aucun rapport de minuterie. « Basique » collecte les rapports de minuterie des répertoires. « Détaillé » collecte aussi ceux des détails des éléments."

msgctxt "#32698"
msgid "Run a TMDb request and write its response to the Kodi log."
msgstr "Exécute une requête TMDb et écrit sa réponse dans le journal de Kodi."

msgctxt "#32699"
msgid "Run a Trakt request and write its response to the Kodi log."
msgstr "Exécute une requête Trakt et écrit sa réponse dans le journal de Kodi."

msgctxt "#32701"
msgid "Store the TMDb account authentication token used by TMDbHelper."
msgstr "Stocke le jeton d'authentification du compte TMDb utilisé par TMDbHelper."

msgctxt "#32702"
msgid "Store the Trakt account authentication token used by TMDbHelper."
msgstr "Stocke le jeton d'authentification du compte Trakt utilisé par TMDbHelper."

msgctxt "#32703"
msgid "Allow other plugins to access the saved OMDb API key."
msgstr "Autorise d'autres extensions à accéder à la clé API OMDb enregistrée."

msgctxt "#32704"
msgid "Allow other plugins to access the saved Fanart.tv client key."
msgstr "Autorise d'autres extensions à accéder à la clé client Fanart.tv enregistrée."

msgctxt "#32706"
msgid "Allow other plugins to access the saved TMDb account token."
msgstr "Autorise d'autres extensions à accéder au jeton du compte TMDb enregistré."

msgctxt "#32707"
msgid "Allow other plugins to access the saved Trakt account token."
msgstr "Autorise d'autres extensions à accéder au jeton du compte Trakt enregistré."

msgctxt "#32708"
msgid "Regional"
msgstr "Régional"

msgctxt "#32709"
msgid "Notifications"
msgstr "Notifications"

msgctxt "#32710"
msgid "Context menu"
msgstr "Menu contextuel"

msgctxt "#32711"
msgid "Navigation"
msgstr "Navigation"

msgctxt "#32712"
msgid "Extra seasons"
msgstr "Saisons supplémentaires"

msgctxt "#32713"
msgid "Next episodes"
msgstr "Prochains épisodes"

msgctxt "#32714"
