msgstr "512 MB"

#: /resources/tmdbhelper/lib/script/sync/provider_directory.py
msgctxt "#32580"
msgid "The route \"{0}\" is not available in TMDbHelper. It may be available in the {1} sync module. Install or enable this module?"
msgstr "Ścieżka „{0}” nie jest dostępna w TMDbHelper. Może być dostępna w module synchronizacji {1}. Zainstalować lub włączyć ten moduł?"

#: /resources/settings.xml
msgctxt "#32581"
msgid "Ratings providers"
msgstr "Dostawcy ocen"

#: /resources/settings.xml
msgctxt "#32582"
msgid "Choose which installed ratings providers to use. Existing cached ratings are retained."
msgstr "Wybierz, których zainstalowanych dostawców ocen używać. Istniejące oceny w pamięci podręcznej są zachowywane."

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32583"
msgid "{0}. {1} ({2})"
msgstr "{0}. {1} ({2})"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32584"
msgid "Enabled"
msgstr "Włączony"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32585"
msgid "Disabled"
msgstr "Wyłączony"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32586"
msgid "Move up"
msgstr "Przenieś wyżej"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32587"
msgid "Move down"
msgstr "Przenieś niżej"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32588"
msgid "No ratings providers are installed."
msgstr "Nie zainstalowano żadnych dostawców ocen."

#: /resources/settings.xml
msgctxt "#32591"
msgid "Provider priority"
msgstr "Priorytet dostawców"

#: /resources/settings.xml
msgctxt "#32592"
msgid "Order ratings providers from highest to lowest priority. Existing cached ratings are retained."
msgstr "Uporządkuj dostawców ocen od najwyższego do najniższego priorytetu. Istniejące oceny w pamięci podręcznej są zachowywane."

#: /resources/settings.xml /resources/tmdbhelper/lib/player/dialog/episode_groups.py
msgctxt "#32593"
msgid "Episode numbering"
msgstr "Numeracja odcinków"

#: /resources/settings.xml /resources/tmdbhelper/lib/player/dialog/episode_groups.py
msgctxt "#32594"
msgid "Default"
msgstr "Domyślnie"

#: /resources/settings.xml
msgctxt "#32595"
msgid "Select"
msgstr "Wybierz"

#: /resources/settings.xml
msgctxt "#32596"
msgid "Group"
msgstr "Grupa"

#: /resources/settings.xml
msgctxt "#32597"
msgid "Use TMDb numbers, ask for a group, or use the current group. Individual players can override this choice."
msgstr "Używaj numeracji TMDb, pytaj o grupę lub używaj bieżącej grupy. Poszczególne playery mogą nadpisać ten wybór."

#: /resources/settings.xml
msgctxt "#32599"
msgid "Choose providers to receive playback activity. Clear all selections to disable scrobbling."
msgstr "Wybierz dostawców, do których ma trafiać aktywność odtwarzania. Wyczyść wszystkie wybory, aby wyłączyć rejestrowanie."

#: /resources/tmdbhelper/lib/items/directories/base/basedir_sync.py
msgctxt "#32600"
msgid "Currently Watching"
msgstr "Obecnie oglądane"

#: /resources/tmdbhelper/lib/items/directories/base/basedir_sync.py
msgctxt "#32602"
msgid "Your Next Movies"
msgstr "Twoje następne filmy"

#: /resources/settings.xml
msgctxt "#32603"
msgid "Update collections"
msgstr "Aktualizuj kolekcje"

#: /resources/settings.xml
msgctxt "#32604"
msgid "Discover new movie collections daily and refresh older ones for Your Next Movies after its first use."
msgstr "Codziennie odkrywaj nowe kolekcje filmów i odświeżaj starsze na potrzeby „Twoich następnych filmów” po pierwszym użyciu."

#: /resources/settings.xml
msgctxt "#32605"
msgid "Daily request limit"
msgstr "Dzienny limit zapytań"

#: /resources/settings.xml
msgctxt "#32606"
msgid "Limit daily movie collection requests, including retries. New collections take priority over overdue refreshes."
msgstr "Ogranicz dzienne zapytania o kolekcje filmów, łącznie z ponowieniami. Nowe kolekcje mają pierwszeństwo przed zaległymi odświeżeniami."

#: /resources/tmdbhelper/lib/items/directories/sync/mapper_nextmovies.py
msgctxt "#32607"
msgid "Drop collection"
msgstr "Porzuć kolekcję"

#: /resources/settings.xml
msgctxt "#32608"
msgid "Advanced"
msgstr "Zaawansowane"

#: /resources/settings.xml
msgctxt "#32609"
msgid "Include movie releases outside your selected country when filtering TMDb lists."
msgstr "Uwzględniaj premiery filmów spoza wybranego kraju podczas filtrowania list TMDb."

#: /resources/settings.xml
msgctxt "#32610"
msgid "Show authorisation and sync notifications when Kodi starts."
msgstr "Pokazuj powiadomienia o autoryzacji i synchronizacji przy uruchomieniu Kodi."

#: /resources/settings.xml
msgctxt "#32611"
msgid "Show notifications while user data is synchronising."
msgstr "Pokazuj powiadomienia podczas synchronizacji danych użytkownika."

#: /resources/settings.xml
msgctxt "#32612"
msgid "Show a notification when a service connection fails."
msgstr "Pokazuj powiadomienie, gdy połączenie z usługą nie powiedzie się."

#: /resources/settings.xml
msgctxt "#32613"
msgid "Show Browse lists in the item context menu."
msgstr "Pokazuj „Przeglądaj listy” w menu kontekstowym pozycji."

#: /resources/settings.xml
msgctxt "#32614"
msgid "Show sync actions in the item context menu."
msgstr "Pokazuj akcje synchronizacji w menu kontekstowym pozycji."

#: /resources/settings.xml
msgctxt "#32615"
msgid "Show TMDb account actions in the item context menu."
msgstr "Pokazuj akcje konta TMDb w menu kontekstowym pozycji."

#: /resources/settings.xml
msgctxt "#32616"
msgid "Show Refresh details in the item context menu."
msgstr "Pokazuj „Odśwież szczegóły” w menu kontekstowym pozycji."

#: /resources/settings.xml
msgctxt "#32617"
msgid "Show Modify artwork in the item context menu."
msgstr "Pokazuj „Modyfikuj grafikę” w menu kontekstowym pozycji."

#: /resources/settings.xml
msgctxt "#32618"
msgid "Add to library"
msgstr "Dodaj do biblioteki"

#: /resources/settings.xml
msgctxt "#32619"
msgid "Show Add to library in the item context menu."
msgstr "Pokazuj „Dodaj do biblioteki” w menu kontekstowym pozycji."

#: /resources/settings.xml
msgctxt "#32620"
msgid "Show Add node in the item context menu."
msgstr "Pokazuj „Dodaj węzeł” w menu kontekstowym pozycji."

#: /resources/settings.xml
msgctxt "#32621"
msgid "Show a next-page item in widgets when more results are available."
msgstr "Pokazuj pozycję „Następna strona” w widżetach, gdy dostępnych jest więcej wyników."

#: /resources/settings.xml
msgctxt "#32622"
msgid "Open the episode list directly instead of showing seasons."
msgstr "Otwieraj bezpośrednio listę odcinków zamiast pokazywać sezony."

#: /resources/settings.xml
msgctxt "#32623"
msgid "Show the additional Specials season entry."
msgstr "Pokazuj dodatkową pozycję sezonu: Specjalne."

#: /resources/settings.xml
msgctxt "#32624"
msgid "Show the additional Anticipated season entry."
msgstr "Pokazuj dodatkową pozycję sezonu: Nadchodzące."

#: /resources/settings.xml
msgctxt "#32625"
msgid "Show the additional episode Groups entry."
msgstr "Pokazuj dodatkową pozycję: Grupy odcinków."

#: /resources/settings.xml
msgctxt "#32626"
msgid "Show the additional Up next season entry when signed in to Trakt."
msgstr "Pokazuj dodatkową pozycję sezonu Następne po zalogowaniu do Trakt."

#: /resources/settings.xml
msgctxt "#32627"
msgid "Combine episodes from the same show airing on the same day into one calendar entry."
msgstr "Łącz odcinki tego samego serialu emitowane tego samego dnia w jedną pozycję kalendarza."

#: /resources/settings.xml
msgctxt "#32628"
msgid "Open the local TV show from entries in the next-aired library calendar."
msgstr "Otwieraj lokalny serial z pozycji w kalendarzu emisji biblioteki."

#: /resources/settings.xml
msgctxt "#32629"
msgid "Choose the artwork used for next-episode thumbnails."
msgstr "Wybierz grafikę używaną dla miniaturek następnych odcinków."

#: /resources/settings.xml
msgctxt "#32630"
msgid "Check the calendar for next episodes. Slower, but more accurate."
msgstr "Sprawdzaj kalendarz następnych odcinków. Wolniej, ale dokładniej."

#: /resources/settings.xml
msgctxt "#32631"
msgid "Load this many pages per request for basic TMDb lists. Higher values are slower."
msgstr "Ładuj tyle stron na zapytanie dla podstawowych list TMDb. Wyższe wartości są wolniejsze."

#: /resources/settings.xml
msgctxt "#32632"
msgid "Load this many pages per request for other basic lists. Higher values are slower."
msgstr "Ładuj tyle stron na zapytanie dla pozostałych list podstawowych. Wyższe wartości są wolniejsze."

#: /resources/settings.xml
msgctxt "#32633"
msgid "Load this many pages per request for synced database lists. Higher values are slower."
msgstr "Ładuj tyle stron na zapytanie dla list synchronizowanej bazy danych. Wyższe wartości są wolniejsze."

#: /resources/settings.xml
msgctxt "#32634"
msgid "Cache the items in Trakt custom lists you own for 24 hours."
msgstr "Przechowuj w pamięci podręcznej pozycje z własnych list niestandardowych Trakt przez 24 godz."

#: /resources/settings.xml
msgctxt "#32635"
msgid "Choose the default resolution of artwork downloaded from TMDb. Poster and fanart settings can override this default."
msgstr "Wybierz domyślną rozdzielczość grafik pobieranych z TMDb. Ustawienia plakatów i fanartów mogą zastąpić to domyślne ustawienie."

#: /resources/settings.xml
msgctxt "#32636"
msgid "Fetch Fanart.tv artwork for plugin items. Additional lookups are slower."
msgstr "Pobieraj grafiki Fanart.tv dla pozycji wtyczki. Dodatkowe wyszukiwania są wolniejsze."

#: /resources/settings.xml
msgctxt "#32637"
msgid "Prefer Fanart.tv artwork over TMDb artwork when both are available."
msgstr "Preferuj grafiki Fanart.tv zamiast grafik TMDb, gdy obie są dostępne."

#: /resources/settings.xml
msgctxt "#32638"
msgid "Prefer artwork in your selected language when choosing images."
msgstr "Preferuj grafiki w wybranym języku podczas wybierania obrazów."

#: /resources/settings.xml
msgctxt "#32639"
msgid "Choose the folder containing custom icons for TMDb genres."
msgstr "Wybierz folder zawierający niestandardowe ikony gatunków TMDb."

#: /resources/settings.xml
msgctxt "#32640"
msgid "Choose the folder containing custom icons for Trakt genres."
msgstr "Wybierz folder zawierający niestandardowe ikony gatunków Trakt."

#: /resources/settings.xml
msgctxt "#32641"
msgid "Choose the folder containing custom TMDb watch-provider icons."
msgstr "Wybierz folder zawierający niestandardowe ikony dostawców TMDb."

#: /resources/settings.xml
msgctxt "#32642"
msgid "Retrieve background artwork for genre entries."
msgstr "Pobieraj grafiki tła dla pozycji gatunków."

#: /resources/settings.xml
msgctxt "#32643"
msgid "Retrieve background artwork for watch-provider entries."
msgstr "Pobieraj grafiki tła dla pozycji dostawców."

#: /resources/settings.xml
msgctxt "#32644"
msgid "Choose the default player used for movies."
msgstr "Wybierz domyślny player używany dla filmów."

#: /resources/settings.xml
msgctxt "#32645"
msgid "Choose the default player used for TV episodes."
msgstr "Wybierz domyślny player używany dla odcinków seriali."

#: /resources/settings.xml
msgctxt "#32646"
msgid "Automatically play using available providers instead of asking for a player."
msgstr "Odtwarzaj automatycznie przy użyciu dostępnych dostawców, zamiast pytać o playera."

#: /resources/settings.xml
msgctxt "#32647"
msgid "Choose how playback uses files already in the Kodi library."
msgstr "Wybierz, jak odtwarzanie ma korzystać z plików już znajdujących się w bibliotece Kodi."

#: /resources/settings.xml
msgctxt "#32648"
msgid "Show one player entry per plugin instead of separate entries for each player."
msgstr "Pokazuj jedną pozycję playera na wtyczkę, zamiast osobnych pozycji dla każdego playera."

#: /resources/settings.xml
msgctxt "#32649"
msgid "Include player definitions supplied with the add-on."
msgstr "Uwzględniaj definicje playerów dostarczane z dodatkiem."

#: /resources/settings.xml
msgctxt "#32650"
msgid "Download player definitions from the URL you provide."
msgstr "Pobieraj definicje playerów z podanego adresu URL."

#: /resources/settings.xml
msgctxt "#32651"
msgid "Choose and customise the available player definitions."
msgstr "Wybierz i dostosuj dostępne definicje playerów."

#: /resources/settings.xml
msgctxt "#32652"
msgid "Ask for a TMDb rating after watching an item when signed in to TMDb."
msgstr "Pytaj o ocenę TMDb po obejrzeniu pozycji po zalogowaniu do TMDb."

#: /resources/settings.xml
msgctxt "#32653"
msgid "Movies folder"
msgstr "Folder filmów"

#: /resources/settings.xml
msgctxt "#32654"
msgid "Choose where movie STRM and NFO files are created for the Kodi library."
msgstr "Wybierz, gdzie tworzone są pliki STRM i NFO filmów dla biblioteki Kodi."

#: /resources/settings.xml
msgctxt "#32655"
msgid "Choose where TV show STRM and NFO files are created for the Kodi library."
msgstr "Wybierz, gdzie tworzone są pliki STRM i NFO seriali dla biblioteki Kodi."

#: /resources/settings.xml
msgctxt "#32656"
msgid "Scan the Kodi library after adding items through TMDbHelper."
msgstr "Skanuj bibliotekę Kodi po dodaniu pozycji przez TMDbHelper."

#: /resources/settings.xml
msgctxt "#32657"
msgid "Automatically update library exports and add new or missing episodes."
msgstr "Automatycznie aktualizuj eksporty biblioteki i dodawaj nowe lub brakujące odcinki."

#: /resources/settings.xml
msgctxt "#32658"
msgid "Choose the hour for the daily library update."
msgstr "Wybierz godzinę codziennej aktualizacji biblioteki."

#: /resources/settings.xml
msgctxt "#32659"
msgid "Choose the lists used to add items during automatic library updates."
msgstr "Wybierz listy używane do dodawania pozycji podczas automatycznych aktualizacji biblioteki."

#: /resources/settings.xml
msgctxt "#32660"
msgid "Store the source-list identifiers used by automatic library updates."
msgstr "Przechowuj identyfikatory list źródłowych używanych przez automatyczne aktualizacje biblioteki."

#: /resources/settings.xml
msgctxt "#32661"
msgid "Choose which library exports to update now."
msgstr "Wybierz, które eksporty biblioteki zaktualizować teraz."

#: /resources/settings.xml
msgctxt "#32662"
msgid "Choose whether to add local Kodi library details to items."
msgstr "Wybierz, czy dodawać do pozycji szczegóły lokalnej biblioteki Kodi."

#: /resources/settings.xml
msgctxt "#32663"
msgid "Refresh TMDbHelper's cached details from the local Kodi library."
msgstr "Odśwież szczegóły zapisane w pamięci podręcznej TMDbHelper z biblioteki Kodi."

#: /resources/settings.xml
msgctxt "#32664"
msgid "Skip checks after creating library folders on systems that report new folders slowly."
msgstr "Pomijaj sprawdzanie po utworzeniu folderów biblioteki w systemach, które wolno zgłaszają nowe foldery."

#: /resources/settings.xml
msgctxt "#32665"
msgid "Use movie-tmdbhelper.nfo or tvshow-tmdbhelper.nfo instead of the standard NFO filename."
msgstr "Używaj pliku movie-tmdbhelper.nfo lub tvshow-tmdbhelper.nfo zamiast standardowej nazwy pliku NFO."

#: /resources/settings.xml
msgctxt "#32666"
msgid "Connect your Trakt account to TMDbHelper."
msgstr "Połącz swoje konto Trakt z TMDbHelper."

#: /resources/settings.xml
msgctxt "#32667"
msgid "Disconnect your Trakt account from TMDbHelper."
msgstr "Odłącz swoje konto Trakt od TMDbHelper."

#: /resources/settings.xml
msgctxt "#32668"
msgid "Open settings"
msgstr "Otwórz ustawienia"

#: /resources/settings.xml
msgctxt "#32669"
msgid "Install MDbList support if needed, then open its provider settings."
msgstr "W razie potrzeby zainstaluj obsługę MDbList, a następnie otwórz ustawienia jej dostawcy."

#: /resources/settings.xml
msgctxt "#32671"
msgid "Enter your OMDb API key for additional ratings and metadata."
msgstr "Wprowadź swój klucz API OMDb, aby uzyskać dodatkowe oceny i metadane."

#: /resources/settings.xml
msgctxt "#32672"
msgid "Enter your RatingPosterDB API key for posters with ratings."
msgstr "Wprowadź swój klucz API RatingPosterDB dla plakatów z ocenami."

#: /resources/settings.xml
msgctxt "#32674"
msgid "Enter your Fanart.tv client key for artwork lookups."
msgstr "Wprowadź swój klucz klienta Fanart.tv do wyszukiwania grafik."

#: /resources/settings.xml
msgctxt "#32675"
msgid "Configure providers"
msgstr "Konfiguruj dostawców"

#: /resources/settings.xml
msgctxt "#32676"
msgid "Store the selected ratings providers and their priority order."
msgstr "Przechowuj wybranych dostawców ocen i ich kolejność priorytetów."

#: /resources/settings.xml
msgctxt "#32677"
msgid "Choose a watchlist provider, install one, or select None to disable watchlist lists."
msgstr "Wybierz dostawcę listy obserwowanych, zainstaluj go lub wybierz „Brak”, aby wyłączyć listy obserwowanych."

#: /resources/settings.xml
msgctxt "#32678"
msgid "Choose a collection provider, install one, or select None to disable collection lists."
msgstr "Wybierz dostawcę kolekcji, zainstaluj go lub wybierz „Brak”, aby wyłączyć listy kolekcji."

#: /resources/settings.xml
msgctxt "#32680"
msgid "Choose a supported sync provider to install or enable."
msgstr "Wybierz obsługiwanego dostawcę synchronizacji do zainstalowania lub włączenia."

#: /resources/settings.xml
msgctxt "#32681"
msgid "Synchronise watched status and resume points with the selected history provider."
msgstr "Synchronizuj status obejrzenia i punkty wznowienia z wybranym dostawcą historii."

#: /resources/settings.xml
msgctxt "#32682"
msgid "Clear cached synced user data so it can be downloaded again."
msgstr "Wyczyść pamięć podręczną zsynchronizowanych danych użytkownika, aby można je było ponownie pobrać."

#: /resources/settings.xml
msgctxt "#32683"
msgid "Choose which watch providers are included in provider data lookups."
msgstr "Wybierz, którzy dostawcy są uwzględniani w wyszukiwaniu danych dostawców."

#: /resources/settings.xml
msgctxt "#32684"
msgid "Allow the image monitor to fetch artwork from online sources."
msgstr "Zezwól monitorowi obrazów na pobieranie grafik ze źródeł online."

#: /resources/settings.xml
msgctxt "#32685"
msgid "Allow the details monitor to fetch ratings from online sources."
msgstr "Zezwól monitorowi szczegółów na pobieranie ocen ze źródeł online."

#: /resources/settings.xml
msgctxt "#32686"
msgid "Use TMDbHelper artwork instead of the clearlogo supplied by the playback monitor."
msgstr "Używaj grafiki TMDbHelper zamiast clearlogo dostarczanego przez monitor odtwarzania."

#: /resources/settings.xml
msgctxt "#32687"
msgid "Set how long the dummy video plays when resolving playback, in seconds."
msgstr "Ustaw, jak długo odtwarzane jest fikcyjne wideo podczas rozwiązywania odtwarzania, w sekundach."

#: /resources/settings.xml
msgctxt "#32688"
msgid "Set the delay after the dummy video stops before playback continues, in seconds."
msgstr "Ustaw opóźnienie po zatrzymaniu fikcyjnego wideo przed kontynuowaniem odtwarzania, w sekundach."

#: /resources/settings.xml
msgctxt "#32689"
msgid "Restrict URL resolving to library STRM playback."
msgstr "Ogranicz rozwiązywanie adresów URL do odtwarzania plików STRM biblioteki."

#: /resources/settings.xml
msgctxt "#32690"
msgid "Refresh cached Kodi library details when building the player list."
msgstr "Odśwież pamięć podręczną biblioteki Kodi podczas budowania listy playerów."

#: /resources/settings.xml
msgctxt "#32691"
msgid "Use the alternative TMDb API address for network compatibility."
msgstr "Używaj alternatywnego adresu API TMDb w celu zapewnienia zgodności sieciowej."

#: /resources/settings.xml
msgctxt "#32692"
msgid "Set the maximum number of concurrent threads. Zero means unlimited."
msgstr "Ustaw maksymalną liczbę równoczesnych wątków. Zero oznacza brak limitu."

#: /resources/settings.xml
msgctxt "#32693"
msgid "Choose a custom location for TMDbHelper cache databases."
msgstr "Wybierz niestandardową lokalizację baz danych pamięci podręcznej TMDbHelper."

#: /resources/settings.xml
msgctxt "#32694"
msgid "Choose a custom location for cached images."
msgstr "Wybierz niestandardową lokalizację pamięci podręcznej obrazów."

#: /resources/settings.xml
msgctxt "#32695"
msgid "Delete cached TMDb list details for troubleshooting. Lists will be downloaded again when needed."
msgstr "Usuń pamięć podręczną list TMDb, by rozwiązać problemy. Listy zostaną ponownie pobrane w razie potrzeby."

#: /resources/settings.xml
msgctxt "#32696"
msgid "Write additional diagnostic information to the Kodi log."
msgstr "Zapisuj dodatkowe informacje diagnostyczne w dzienniku Kodi."

#: /resources/settings.xml
msgctxt "#32697"
msgid "Disabled collects no timer reports. Basic collects directory timer reports. Detailed also collects item detail timer reports."
msgstr "Wyłączony: brak raportów timera. Podstawowy: raporty timera katalogów. Szczegółowy: również raporty timerów poszczególnych pozycji."

#: /resources/settings.xml
msgctxt "#32698"
msgid "Run a TMDb request and write its response to the Kodi log."
msgstr "Wykonaj zapytanie TMDb i zapisz jego odpowiedź w dzienniku Kodi."

#: /resources/settings.xml
msgctxt "#32699"
msgid "Run a Trakt request and write its response to the Kodi log."
msgstr "Wykonaj zapytanie Trakt i zapisz jego odpowiedź w dzienniku Kodi."

#: /resources/settings.xml
msgctxt "#32701"
msgid "Store the TMDb account authentication token used by TMDbHelper."
msgstr "Przechowuj token uwierzytelniania konta TMDb używany przez TMDbHelper."

#: /resources/settings.xml
msgctxt "#32702"
msgid "Store the Trakt account authentication token used by TMDbHelper."
msgstr "Przechowuj token uwierzytelniania konta Trakt używany przez TMDbHelper."

#: /resources/settings.xml
msgctxt "#32703"
msgid "Allow other plugins to access the saved OMDb API key."
msgstr "Zezwól innym wtyczkom na dostęp do zapisanego klucza API OMDb."

#: /resources/settings.xml
msgctxt "#32704"
msgid "Allow other plugins to access the saved Fanart.tv client key."
msgstr "Zezwól innym wtyczkom na dostęp do zapisanego klucza klienta Fanart.tv."

#: /resources/settings.xml
msgctxt "#32706"
msgid "Allow other plugins to access the saved TMDb account token."
msgstr "Zezwól innym wtyczkom na dostęp do zapisanego tokena konta TMDb."

#: /resources/settings.xml
msgctxt "#32707"
msgid "Allow other plugins to access the saved Trakt account token."
msgstr "Zezwól innym wtyczkom na dostęp do zapisanego tokena konta Trakt."

