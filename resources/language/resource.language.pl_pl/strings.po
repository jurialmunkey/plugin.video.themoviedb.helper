msgctxt "#32559"
msgid "{0} (enable)"
msgstr "{0} (włącz)"

#: /resources/tmdbhelper/lib/script/sync/provider_default.py
msgctxt "#32560"
msgid "Set {0} as the default sync provider? This clears all current provider selections and uses {0} for every feature it supports."
msgstr "Ustawić {0} jako domyślnego dostawcę synchronizacji? Spowoduje to wyczyszczenie wszystkich bieżących wyborów dostawców i użycie {0} dla każdej obsługiwanej funkcji."

#: /resources/tmdbhelper/lib/script/sync/provider_default.py
msgctxt "#32561"
msgid "Default"
msgstr "Domyślny"

#: /resources/tmdbhelper/lib/script/sync/provider_default.py
msgctxt "#32562"
msgid "Custom"
msgstr "Niestandardowy"

#: /resources/tmdbhelper/lib/script/method/sync_provider.py
msgctxt "#32563"
msgid "You are enabling {0}, a third-party sync service outside TMDbHelper's trusted list. Only continue if you trust this service and understand the risks, including sharing your viewing activity and account data."
msgstr "Włączasz {0}, zewnętrzną usługę synchronizacji spoza listy zaufanych TMDbHelper. Kontynuuj tylko, jeśli ufasz tej usłudze i rozumiesz ryzyko, w tym udostępnianie Twojej aktywności oglądania i danych konta."

#: /resources/settings.xml
msgctxt "#32564"
msgid "Image cache limit"
msgstr "Limit pamięci podręcznej obrazów"

#: /resources/settings.xml
msgctxt "#32565"
msgid "Set the size limit per image-cache folder. Unlimited disables automatic cleanup."
msgstr "Ustaw limit rozmiaru na folder pamięci podręcznej obrazów. Wartość „Nieograniczony” wyłącza automatyczne czyszczenie."

#: /resources/settings.xml
msgctxt "#32566"
msgid "Unlimited"
msgstr "Nieograniczony"

#: /resources/settings.xml /resources/tmdbhelper/lib/script/method/image_cache.py
msgctxt "#32567"
msgid "Clean image cache"
msgstr "Wyczyść pamięć podręczną obrazów"

#: /resources/tmdbhelper/lib/script/method/image_cache.py
msgctxt "#32568"
msgid "Scanning {0}: {1} of {2} files"
msgstr "Skanowanie {0}: {1} z {2} plików"

#: /resources/tmdbhelper/lib/script/method/image_cache.py
msgctxt "#32569"
msgid "Cleaning {0}"
msgstr "Czyszczenie {0}"

#: /resources/tmdbhelper/lib/script/method/image_cache.py
msgctxt "#32570"
msgid "Space reclaimed: {0}"
msgstr "Odzyskane miejsce: {0}"

#: /resources/tmdbhelper/lib/script/method/image_cache.py
msgctxt "#32571"
msgid "Image cache cleanup finished. Space reclaimed: {0}."
msgstr "Czyszczenie pamięci podręcznej obrazów zakończone. Odzyskane miejsce: {0}."

#: /resources/tmdbhelper/lib/script/method/image_cache.py
msgctxt "#32572"
msgid "Image cache cleanup cancelled. Space reclaimed: {0}."
msgstr "Czyszczenie pamięci podręcznej obrazów anulowane. Odzyskane miejsce: {0}."

#: /resources/tmdbhelper/lib/script/method/image_cache.py
msgctxt "#32573"
msgid "Image cache cleanup is disabled while the target size is Unlimited."
msgstr "Czyszczenie pamięci podręcznej obrazów jest wyłączone, gdy docelowy rozmiar to „Nieograniczony”."

#: /resources/settings.xml
msgctxt "#32574"
msgid "Save settings and clean the image cache to the selected size limit."
msgstr "Zapisz ustawienia i wyczyść pamięć podręczną obrazów do wybranego limitu rozmiaru."

