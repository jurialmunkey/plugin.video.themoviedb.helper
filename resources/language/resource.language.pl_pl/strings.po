msgctxt "#32740"
msgid "Provider modules"
msgstr "Moduły dostawców"

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32741"
msgid "{0} ({1})"
msgstr "{0} ({1})"

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32742"
msgid "Set {0} as the default sync provider? This replaces the current sync selections and clears features it does not support. Ratings and scrobbling are configured separately."
msgstr "Ustawić {0} jako domyślnego dostawcę synchronizacji? Spowoduje to zastąpienie bieżących wyborów synchronizacji i wyczyszczenie funkcji, których nie obsługuje. Oceny i rejestrowanie są konfigurowane osobno."

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32743"
msgid "Enable {0} as a ratings provider?"
msgstr "Włączyć {0} jako dostawcę ocen?"

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32744"
msgid "Enable scrobbling with {0}?"
msgstr "Włączyć rejestrowanie za pomocą {0}?"

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32745"
msgid "Are you sure you want to disable {0}? The module and its features will be unavailable."
msgstr "Czy na pewno chcesz wyłączyć {0}? Moduł i jego funkcje będą niedostępne."

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32746"
msgid "Disabling this module will remove it from:\n{0}"
msgstr "Wyłączenie tego modułu usunie go z:\n{0}"

#: /resources/tmdbhelper/lib/script/sync/provider_errors.py
msgctxt "#32747"
msgid "Provider module unavailable"
msgstr "Moduł dostawcy jest niedostępny"

#: /resources/tmdbhelper/lib/script/sync/provider_errors.py
msgctxt "#32748"
msgid "The {0} module could not be loaded and its features are temporarily unavailable. Update the module to the latest version and try again. Your settings and synced data have been kept."
msgstr "Nie udało się załadować modułu {0}, więc jego funkcje są chwilowo niedostępne. Zaktualizuj moduł do najnowszej wersji i spróbuj ponownie. Twoje ustawienia i zsynchronizowane dane zostały zachowane."

#: /resources/settings.xml
msgctxt "#32749"
msgid "Trakt settings"
msgstr "Ustawienia Trakt"

#: /resources/settings.xml
msgctxt "#32750"
msgid "Configure Trakt list caching, genre icons, and next-episode calendar checks."
msgstr "Skonfiguruj buforowanie list Trakt, ikony gatunków oraz sprawdzanie kalendarza pod kątem następnych odcinków."

#: /resources/settings.xml
msgctxt "#32751"
msgid "Poster image quality"
msgstr "Jakość obrazu plakatów"

#: /resources/settings.xml
msgctxt "#32752"
msgid "Fanart image quality"
msgstr "Jakość obrazu fanartów"

#: /resources/settings.xml
msgctxt "#32754"
msgid "Choose the resolution of TMDb posters and actor portraits, or use the default image quality setting."
msgstr "Wybierz rozdzielczość plakatów i portretów aktorów z TMDb lub skorzystaj z domyślnych ustawień jakości obrazu."

#: /resources/settings.xml
msgctxt "#32755"
msgid "Choose the resolution of TMDb fanart, landscape, and extra fanart, or use the default image quality setting."
msgstr "Wybierz rozdzielczość fanartów, landscape'ów i dodatkowych fanartów TMDb lub skorzystaj z domyślnych ustawień jakości obrazu."

#: /resources/settings.xml
msgctxt "#32756"
msgid "TMDb account"
msgstr "Konto TMDb"

#: /resources/settings.xml
msgctxt "#32757"
msgid "Sign in to your TMDb account using a web browser or QR code."
msgstr "Zaloguj się na swoje konto TMDb za pomocą przeglądarki internetowej lub kodu QR."

#: /resources/settings.xml
msgctxt "#32758"
msgid "Sign out of your TMDb account and remove the saved authentication token."
msgstr "Wyloguj się ze swojego konta TMDb i usuń zapisany token uwierzytelniający."

#: /resources/settings.xml
msgctxt "#32759"
msgid "Basic"
msgstr "Podstawowy"

#: /resources/settings.xml
msgctxt "#32760"
msgid "Detailed"
msgstr "Szczegółowy"

#: /resources/settings.xml
msgctxt "#32761"
msgid "Show expired widget lists for up to"
msgstr "Pokaż wygasłe listy widżetów do maks."

#: /resources/settings.xml
msgctxt "#32762"
msgid "When a widget's TMDb list is older than its normal 6 hour cache, show the saved list straight away and download the new list after the widget has loaded. The new list appears the next time Kodi reloads the widget. Lists for today, such as Airing Today, always wait for new data. Off waits for new data every time."
msgstr "Gdy lista TMDb w widżecie jest starsza niż standardowy 6-godz. okres przechowywania w pamięci podręcznej, wyświetlana jest zapisana lista, a nowa pobierana po załadowaniu widżetu. Nowa lista pojawi się przy następnym przeładowaniu widżetu przez Kodi. Listy dotyczące bieżącego dnia, takie jak Emitowane dzisiaj, zawsze czekają na nowe dane. Opcja Wyłączone czeka na nowe dane za każdym razem."

