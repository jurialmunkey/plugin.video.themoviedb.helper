msgctxt "#32764"
msgid "24 hours"
msgstr "24 ore"

#: /resources/settings.xml
msgctxt "#32765"
msgid "48 hours"
msgstr "48 ore"

#: /resources/settings.xml
msgctxt "#32766"
msgid "72 hours"
msgstr "72 ore"

