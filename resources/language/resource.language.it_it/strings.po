msgid "The route \"{0}\" is not available in TMDbHelper. It may be available in the {1} sync module. Install or enable this module?"
msgstr "Il percorso \"{0}\" non è disponibile in TMDbHelper. Potrebbe essere disponibile nel modulo di sincronizzazione {1}. Vuoi installare o abilitare questo modulo?"

#: /resources/settings.xml
msgctxt "#32581"
msgid "Ratings providers"
msgstr "Fonti delle valutazioni"

#: /resources/settings.xml
msgctxt "#32582"
msgid "Choose which installed ratings providers to use. Existing cached ratings are retained."
msgstr "Scegli quali provider di valutazioni installati utilizzare. Le valutazioni già presenti nella cache verranno conservate."

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32583"
msgid "{0}. {1} ({2})"
msgstr "{0}. {1} ({2})"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32584"
msgid "Enabled"
msgstr "Abilitato"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32585"
msgid "Disabled"
msgstr "Disabilitato"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32586"
msgid "Move up"
msgstr "Sposta in alto"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32587"
msgid "Move down"
msgstr "Sposta in basso"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32588"
msgid "No ratings providers are installed."
msgstr "Non è installata alcuna fonte di valutazioni."

#: /resources/settings.xml
msgctxt "#32591"
msgid "Provider priority"
msgstr "Priorità provider"

#: /resources/settings.xml
msgctxt "#32592"
msgid "Order ratings providers from highest to lowest priority. Existing cached ratings are retained."
msgstr "Ordina i provider di valutazioni in base alla priorità, dalla più alta alla più bassa. Le valutazioni già presenti nella cache verranno conservate."

#: /resources/settings.xml /resources/tmdbhelper/lib/player/dialog/episode_groups.py
msgctxt "#32593"
msgid "Episode numbering"
msgstr "Numerazione degli episodi"

#: /resources/settings.xml /resources/tmdbhelper/lib/player/dialog/episode_groups.py
msgctxt "#32594"
msgid "Default"
msgstr "Predefinito"

#: /resources/settings.xml
msgctxt "#32595"
msgid "Select"
msgstr "Seleziona"

#: /resources/settings.xml
msgctxt "#32596"
msgid "Group"
msgstr "Gruppo"

#: /resources/settings.xml
msgctxt "#32597"
msgid "Use TMDb numbers, ask for a group, or use the current group. Individual players can override this choice."
msgstr "Utilizza la numerazione di TMDb, chiedi di selezionare un gruppo oppure usa il gruppo corrente. I singoli lettori possono sovrascrivere questa scelta."

#: /resources/settings.xml
msgctxt "#32599"
msgid "Choose providers to receive playback activity. Clear all selections to disable scrobbling."
msgstr "Scegli i provider a cui inviare le attività di riproduzione. Deseleziona tutte le opzioni per disabilitare lo scrobbling."

#: /resources/tmdbhelper/lib/items/directories/base/basedir_sync.py
msgctxt "#32600"
msgid "Currently Watching"
msgstr "In visione"

#: /resources/tmdbhelper/lib/items/directories/base/basedir_sync.py
msgctxt "#32602"
msgid "Your Next Movies"
msgstr "I tuoi prossimi film"

#: /resources/settings.xml
msgctxt "#32603"
msgid "Update collections"
msgstr "Aggiorna le raccolte"

#: /resources/settings.xml
msgctxt "#32604"
msgid "Discover new movie collections daily and refresh older ones for Your Next Movies after its first use."
msgstr "Individua ogni giorno nuove raccolte di film e aggiorna quelle meno recenti per la sezione «I tuoi prossimi film» dopo il primo utilizzo."

#: /resources/settings.xml
msgctxt "#32605"
msgid "Daily request limit"
msgstr "Limite giornaliero di richieste"

#: /resources/settings.xml
msgctxt "#32606"
msgid "Limit daily movie collection requests, including retries. New collections take priority over overdue refreshes."
msgstr "Limita le richieste giornaliere per le raccolte di film, inclusi i tentativi ripetuti. Le nuove raccolte hanno la priorità sugli aggiornamenti arretrati."

#: /resources/tmdbhelper/lib/items/directories/sync/mapper_nextmovies.py
msgctxt "#32607"
msgid "Drop collection"
msgstr "Rimuovi raccolta"

#: /resources/settings.xml
msgctxt "#32608"
msgid "Advanced"
msgstr "Avanzate"

#: /resources/settings.xml
msgctxt "#32609"
msgid "Include movie releases outside your selected country when filtering TMDb lists."
msgstr "Includi le uscite cinematografiche di altri paesi quando filtri gli elenchi di TMDb."

#: /resources/settings.xml
msgctxt "#32610"
msgid "Show authorisation and sync notifications when Kodi starts."
msgstr "Mostra le notifiche di autorizzazione e sincronizzazione all'avvio di Kodi."

#: /resources/settings.xml
msgctxt "#32611"
msgid "Show notifications while user data is synchronising."
msgstr "Mostra le notifiche durante la sincronizzazione dei dati utente."

#: /resources/settings.xml
msgctxt "#32612"
msgid "Show a notification when a service connection fails."
msgstr "Mostra una notifica quando la connessione a un servizio non riesce."

#: /resources/settings.xml
msgctxt "#32613"
msgid "Show Browse lists in the item context menu."
msgstr "Mostra «Esplora elenchi» nel menu contestuale degli elementi."

#: /resources/settings.xml
msgctxt "#32614"
msgid "Show sync actions in the item context menu."
msgstr "Mostra le azioni di sincronizzazione nel menu contestuale degli elementi."

#: /resources/settings.xml
msgctxt "#32615"
msgid "Show TMDb account actions in the item context menu."
msgstr "Mostra le azioni dell'account TMDb nel menu contestuale degli elementi."

#: /resources/settings.xml
msgctxt "#32616"
msgid "Show Refresh details in the item context menu."
msgstr "Mostra «Aggiorna dettagli» nel menu contestuale degli elementi."

#: /resources/settings.xml
msgctxt "#32617"
msgid "Show Modify artwork in the item context menu."
msgstr "Mostra «Modifica artwork» nel menu contestuale degli elementi."

#: /resources/settings.xml
msgctxt "#32618"
msgid "Add to library"
msgstr "Aggiungi alla libreria"

#: /resources/settings.xml
msgctxt "#32619"
msgid "Show Add to library in the item context menu."
msgstr "Mostra «Aggiungi alla libreria» nel menu contestuale degli elementi."

#: /resources/settings.xml
msgctxt "#32620"
msgid "Show Add node in the item context menu."
msgstr "Mostra «Aggiungi nodo» nel menu contestuale degli elementi."

#: /resources/settings.xml
msgctxt "#32621"
msgid "Show a next-page item in widgets when more results are available."
msgstr "Mostra un elemento per passare alla pagina successiva nei widget quando sono disponibili altri risultati."

#: /resources/settings.xml
msgctxt "#32622"
msgid "Open the episode list directly instead of showing seasons."
msgstr "Apri direttamente l'elenco degli episodi anziché mostrare le stagioni."

#: /resources/settings.xml
msgctxt "#32623"
msgid "Show the additional Specials season entry."
msgstr "Mostra la voce aggiuntiva della stagione degli speciali."

#: /resources/settings.xml
msgctxt "#32624"
msgid "Show the additional Anticipated season entry."
msgstr "Mostra la voce aggiuntiva della stagione degli episodi più attesi."

#: /resources/settings.xml
msgctxt "#32625"
msgid "Show the additional episode Groups entry."
msgstr "Mostra la voce aggiuntiva dei gruppi di episodi."

#: /resources/settings.xml
msgctxt "#32626"
msgid "Show the additional Up next season entry when signed in to Trakt."
msgstr "Mostra la voce aggiuntiva «Prossimamente» quando hai effettuato l'accesso a Trakt."

#: /resources/settings.xml
msgctxt "#32627"
msgid "Combine episodes from the same show airing on the same day into one calendar entry."
msgstr "Raggruppa in un'unica voce del calendario gli episodi della stessa serie trasmessi nello stesso giorno."

#: /resources/settings.xml
msgctxt "#32628"
msgid "Open the local TV show from entries in the next-aired library calendar."
msgstr "Apri la serie TV locale selezionandola dalle voci del calendario della libreria relativo alle prossime trasmissioni."

#: /resources/settings.xml
msgctxt "#32629"
msgid "Choose the artwork used for next-episode thumbnails."
msgstr "Scegli l'artwork da utilizzare per le miniature dei prossimi episodi."

#: /resources/settings.xml
msgctxt "#32630"
msgid "Check the calendar for next episodes. Slower, but more accurate."
msgstr "Controlla il calendario per individuare i prossimi episodi. Più lento, ma più preciso."

#: /resources/settings.xml
msgctxt "#32631"
msgid "Load this many pages per request for basic TMDb lists. Higher values are slower."
msgstr "Numero di pagine da caricare per ogni richiesta negli elenchi TMDb di base. Valori più alti comportano tempi maggiori."

#: /resources/settings.xml
msgctxt "#32632"
msgid "Load this many pages per request for other basic lists. Higher values are slower."
msgstr "Numero di pagine da caricare per ogni richiesta negli altri elenchi di base. Valori più alti comportano tempi maggiori."

#: /resources/settings.xml
msgctxt "#32633"
msgid "Load this many pages per request for synced database lists. Higher values are slower."
msgstr "Numero di pagine da caricare per ogni richiesta negli elenchi dei database sincronizzati. Valori più alti comportano tempi maggiori."

#: /resources/settings.xml
msgctxt "#32634"
msgid "Cache the items in Trakt custom lists you own for 24 hours."
msgstr "Memorizza nella cache per 24 ore gli elementi degli elenchi personalizzati di Trakt di cui sei proprietario."

#: /resources/settings.xml
msgctxt "#32635"
msgid "Choose the default resolution of artwork downloaded from TMDb. Poster and fanart settings can override this default."
msgstr "Scegli la risoluzione predefinita delle immagini scaricate da TMDb. Le impostazioni di poster e fanart possono sovrascrivere questo valore."

#: /resources/settings.xml
msgctxt "#32636"
msgid "Fetch Fanart.tv artwork for plugin items. Additional lookups are slower."
msgstr "Recupera l'artwork da Fanart.tv per gli elementi del componente aggiuntivo. Le ricerche aggiuntive rallentano il caricamento."

#: /resources/settings.xml
msgctxt "#32637"
msgid "Prefer Fanart.tv artwork over TMDb artwork when both are available."
msgstr "Preferisci l'artwork di Fanart.tv a quello di TMDb quando entrambi sono disponibili."

#: /resources/settings.xml
msgctxt "#32638"
msgid "Prefer artwork in your selected language when choosing images."
msgstr "Preferisci l'artwork nella lingua selezionata durante la scelta delle immagini."

#: /resources/settings.xml
msgctxt "#32639"
msgid "Choose the folder containing custom icons for TMDb genres."
msgstr "Scegli la cartella contenente le icone personalizzate dei generi TMDb."

#: /resources/settings.xml
msgctxt "#32640"
msgid "Choose the folder containing custom icons for Trakt genres."
msgstr "Scegli la cartella contenente le icone personalizzate dei generi Trakt."

#: /resources/settings.xml
msgctxt "#32641"
msgid "Choose the folder containing custom TMDb watch-provider icons."
msgstr "Scegli la cartella contenente le icone personalizzate dei provider di streaming TMDb."

#: /resources/settings.xml
msgctxt "#32642"
msgid "Retrieve background artwork for genre entries."
msgstr "Recupera le immagini di sfondo per le voci dei generi."

#: /resources/settings.xml
msgctxt "#32643"
msgid "Retrieve background artwork for watch-provider entries."
msgstr "Recupera le immagini di sfondo per le voci dei provider di streaming."

#: /resources/settings.xml
msgctxt "#32644"
msgid "Choose the default player used for movies."
msgstr "Scegli il lettore predefinito per i film."

#: /resources/settings.xml
msgctxt "#32645"
msgid "Choose the default player used for TV episodes."
msgstr "Scegli il lettore predefinito per gli episodi delle serie TV."

#: /resources/settings.xml
msgctxt "#32646"
msgid "Automatically play using available providers instead of asking for a player."
msgstr "Avvia automaticamente la riproduzione utilizzando i provider disponibili, senza chiedere di scegliere un lettore."

#: /resources/settings.xml
msgctxt "#32647"
msgid "Choose how playback uses files already in the Kodi library."
msgstr "Scegli come utilizzare durante la riproduzione i file già presenti nella libreria di Kodi."

#: /resources/settings.xml
msgctxt "#32648"
msgid "Show one player entry per plugin instead of separate entries for each player."
msgstr "Mostra una sola voce per ogni plugin anziché una voce separata per ciascun lettore."

#: /resources/settings.xml
msgctxt "#32649"
msgid "Include player definitions supplied with the add-on."
msgstr "Includi le configurazioni dei lettori fornite con il componente aggiuntivo."

#: /resources/settings.xml
msgctxt "#32650"
msgid "Download player definitions from the URL you provide."
msgstr "Scarica le configurazioni dei lettori dall'URL specificato."

#: /resources/settings.xml
msgctxt "#32651"
msgid "Choose and customise the available player definitions."
msgstr "Scegli e personalizza le configurazioni dei lettori disponibili."

#: /resources/settings.xml
msgctxt "#32652"
msgid "Ask for a TMDb rating after watching an item when signed in to TMDb."
msgstr "Chiedi di assegnare una valutazione su TMDb dopo la visione di un elemento, se hai effettuato l'accesso a TMDb."

#: /resources/settings.xml
msgctxt "#32653"
msgid "Movies folder"
msgstr "Cartella film"

#: /resources/settings.xml
msgctxt "#32654"
msgid "Choose where movie STRM and NFO files are created for the Kodi library."
msgstr "Scegli dove creare i file STRM e NFO dei film destinati alla libreria di Kodi."

#: /resources/settings.xml
msgctxt "#32655"
msgid "Choose where TV show STRM and NFO files are created for the Kodi library."
msgstr "Scegli dove creare i file STRM e NFO delle serie TV destinati alla libreria di Kodi."

#: /resources/settings.xml
msgctxt "#32656"
msgid "Scan the Kodi library after adding items through TMDbHelper."
msgstr "Scansiona la libreria di Kodi dopo aver aggiunto elementi tramite TMDbHelper."

#: /resources/settings.xml
msgctxt "#32657"
msgid "Automatically update library exports and add new or missing episodes."
msgstr "Aggiorna automaticamente le esportazioni della libreria e aggiungi gli episodi nuovi o mancanti."

#: /resources/settings.xml
msgctxt "#32658"
msgid "Choose the hour for the daily library update."
msgstr "Scegli l'ora dell'aggiornamento giornaliero della libreria."

#: /resources/settings.xml
msgctxt "#32659"
msgid "Choose the lists used to add items during automatic library updates."
msgstr "Scegli gli elenchi da utilizzare per aggiungere elementi durante gli aggiornamenti automatici della libreria."

#: /resources/settings.xml
msgctxt "#32660"
msgid "Store the source-list identifiers used by automatic library updates."
msgstr "Memorizza gli identificativi degli elenchi di origine utilizzati dagli aggiornamenti automatici della libreria."

#: /resources/settings.xml
msgctxt "#32661"
msgid "Choose which library exports to update now."
msgstr "Scegli quali esportazioni della libreria aggiornare adesso."

#: /resources/settings.xml
msgctxt "#32662"
msgid "Choose whether to add local Kodi library details to items."
msgstr "Scegli se aggiungere agli elementi i dettagli provenienti dalla libreria locale di Kodi."

#: /resources/settings.xml
msgctxt "#32663"
msgid "Refresh TMDbHelper's cached details from the local Kodi library."
msgstr "Aggiorna i dettagli memorizzati nella cache di TMDbHelper utilizzando la libreria locale di Kodi."

#: /resources/settings.xml
msgctxt "#32664"
msgid "Skip checks after creating library folders on systems that report new folders slowly."
msgstr "Salta i controlli dopo la creazione delle cartelle della libreria nei sistemi che rilevano con ritardo le nuove cartelle."

#: /resources/settings.xml
msgctxt "#32665"
msgid "Use movie-tmdbhelper.nfo or tvshow-tmdbhelper.nfo instead of the standard NFO filename."
msgstr "Utilizza movie-tmdbhelper.nfo o tvshow-tmdbhelper.nfo al posto del nome standard dei file NFO."

#: /resources/settings.xml
msgctxt "#32666"
msgid "Connect your Trakt account to TMDbHelper."
msgstr "Collega il tuo account Trakt a TMDbHelper."

#: /resources/settings.xml
msgctxt "#32667"
msgid "Disconnect your Trakt account from TMDbHelper."
msgstr "Scollega il tuo account Trakt da TMDbHelper."

#: /resources/settings.xml
msgctxt "#32668"
msgid "Open settings"
msgstr "Apri le impostazioni"

#: /resources/settings.xml
msgctxt "#32669"
msgid "Install MDbList support if needed, then open its provider settings."
msgstr "Installa il supporto per MDbList, se necessario, quindi apri le impostazioni del relativo provider."

#: /resources/settings.xml
msgctxt "#32671"
msgid "Enter your OMDb API key for additional ratings and metadata."
msgstr "Inserisci la tua chiave API OMDb per ottenere valutazioni e metadati aggiuntivi."

#: /resources/settings.xml
msgctxt "#32672"
msgid "Enter your RatingPosterDB API key for posters with ratings."
msgstr "Inserisci la tua chiave API RatingPosterDB per ottenere poster con le valutazioni."

#: /resources/settings.xml
msgctxt "#32674"
msgid "Enter your Fanart.tv client key for artwork lookups."
msgstr "Inserisci la tua chiave client Fanart.tv per le ricerche di artwork."

#: /resources/settings.xml
msgctxt "#32675"
msgid "Configure providers"
msgstr "Configura i provider"

#: /resources/settings.xml
msgctxt "#32676"
msgid "Store the selected ratings providers and their priority order."
msgstr "Memorizza i provider di valutazioni selezionati e il relativo ordine di priorità."

#: /resources/settings.xml
msgctxt "#32677"
msgid "Choose a watchlist provider, install one, or select None to disable watchlist lists."
msgstr "Scegli un provider per la lista dei contenuti da guardare, installane uno oppure seleziona «Nessuno» per disabilitare le relative liste."

#: /resources/settings.xml
msgctxt "#32678"
msgid "Choose a collection provider, install one, or select None to disable collection lists."
msgstr "Scegli un provider per le raccolte, installane uno oppure seleziona «Nessuno» per disabilitare le relative liste."

#: /resources/settings.xml
msgctxt "#32680"
msgid "Choose a supported sync provider to install or enable."
msgstr "Scegli un provider di sincronizzazione supportato da installare o attivare."

#: /resources/settings.xml
msgctxt "#32681"
msgid "Synchronise watched status and resume points with the selected history provider."
msgstr "Sincronizza lo stato di visione e i punti di ripresa con il provider della cronologia selezionato."

#: /resources/settings.xml
msgctxt "#32682"
msgid "Clear cached synced user data so it can be downloaded again."
msgstr "Cancella i dati utente sincronizzati e memorizzati nella cache, in modo che possano essere scaricati nuovamente."

#: /resources/settings.xml
msgctxt "#32683"
msgid "Choose which watch providers are included in provider data lookups."
msgstr "Scegli quali provider di streaming includere nelle ricerche dei dati dei provider."

#: /resources/settings.xml
msgctxt "#32684"
msgid "Allow the image monitor to fetch artwork from online sources."
msgstr "Consenti al monitor delle immagini di recuperare artwork da fonti online."

#: /resources/settings.xml
msgctxt "#32685"
msgid "Allow the details monitor to fetch ratings from online sources."
msgstr "Consenti al monitor dei dettagli di recuperare valutazioni da fonti online."

#: /resources/settings.xml
msgctxt "#32686"
msgid "Use TMDbHelper artwork instead of the clearlogo supplied by the playback monitor."
msgstr "Utilizza l'artwork di TMDbHelper al posto del clearlogo fornito dal monitor di riproduzione."

#: /resources/settings.xml
msgctxt "#32687"
msgid "Set how long the dummy video plays when resolving playback, in seconds."
msgstr "Imposta la durata, in secondi, della riproduzione del video segnaposto durante la risoluzione della riproduzione."

#: /resources/settings.xml
msgctxt "#32688"
msgid "Set the delay after the dummy video stops before playback continues, in seconds."
msgstr "Imposta il ritardo, in secondi, tra l'interruzione del video segnaposto e la ripresa della riproduzione."

#: /resources/settings.xml
msgctxt "#32689"
msgid "Restrict URL resolving to library STRM playback."
msgstr "Limita la risoluzione degli URL alla riproduzione dei file STRM della libreria."

#: /resources/settings.xml
msgctxt "#32690"
msgid "Refresh cached Kodi library details when building the player list."
msgstr "Aggiorna i dettagli della libreria di Kodi memorizzati nella cache durante la creazione dell'elenco dei lettori."

#: /resources/settings.xml
msgctxt "#32691"
msgid "Use the alternative TMDb API address for network compatibility."
msgstr "Utilizza l'indirizzo API alternativo di TMDb per garantire la compatibilità di rete."

#: /resources/settings.xml
msgctxt "#32692"
msgid "Set the maximum number of concurrent threads. Zero means unlimited."
msgstr "Imposta il numero massimo di thread simultanei. Zero indica un numero illimitato."

#: /resources/settings.xml
msgctxt "#32693"
msgid "Choose a custom location for TMDbHelper cache databases."
msgstr "Scegli un percorso personalizzato per i database della cache di TMDbHelper."

#: /resources/settings.xml
msgctxt "#32694"
msgid "Choose a custom location for cached images."
msgstr "Scegli un percorso personalizzato per le immagini memorizzate nella cache."

#: /resources/settings.xml
msgctxt "#32695"
msgid "Delete cached TMDb list details for troubleshooting. Lists will be downloaded again when needed."
msgstr "Elimina i dettagli degli elenchi TMDb memorizzati nella cache per la risoluzione dei problemi. Gli elenchi verranno scaricati nuovamente quando necessario."

#: /resources/settings.xml
msgctxt "#32696"
msgid "Write additional diagnostic information to the Kodi log."
msgstr "Registra informazioni diagnostiche aggiuntive nel log di Kodi."

#: /resources/settings.xml
msgctxt "#32697"
msgid "Disabled collects no timer reports. Basic collects directory timer reports. Detailed also collects item detail timer reports."
msgstr "Disattivato non raccoglie alcun report dei timer. Base raccoglie i report dei timer delle directory. Dettagliata raccoglie anche i report dei timer relativi ai dettagli degli elementi."

#: /resources/settings.xml
msgctxt "#32698"
msgid "Run a TMDb request and write its response to the Kodi log."
msgstr "Esegui una richiesta a TMDb e registra la relativa risposta nel log di Kodi."

#: /resources/settings.xml
msgctxt "#32699"
msgid "Run a Trakt request and write its response to the Kodi log."
msgstr "Esegui una richiesta a Trakt e registra la relativa risposta nel log di Kodi."

#: /resources/settings.xml
msgctxt "#32701"
msgid "Store the TMDb account authentication token used by TMDbHelper."
msgstr "Memorizza il token di autenticazione dell'account TMDb utilizzato da TMDbHelper."

#: /resources/settings.xml
msgctxt "#32702"
msgid "Store the Trakt account authentication token used by TMDbHelper."
msgstr "Memorizza il token di autenticazione dell'account Trakt utilizzato da TMDbHelper."

#: /resources/settings.xml
msgctxt "#32703"
msgid "Allow other plugins to access the saved OMDb API key."
msgstr "Consenti agli altri plugin di accedere alla chiave API OMDb salvata."

#: /resources/settings.xml
msgctxt "#32704"
msgid "Allow other plugins to access the saved Fanart.tv client key."
msgstr "Consenti agli altri plugin di accedere alla chiave client Fanart.tv salvata."

#: /resources/settings.xml
msgctxt "#32706"
msgid "Allow other plugins to access the saved TMDb account token."
msgstr "Consenti agli altri plugin di accedere al token dell'account TMDb salvato."

#: /resources/settings.xml
msgctxt "#32707"
msgid "Allow other plugins to access the saved Trakt account token."
msgstr "Consenti agli altri plugin di accedere al token dell'account Trakt salvato."

#: /resources/settings.xml
msgctxt "#32708"
msgid "Regional"
msgstr "Impostazioni regionali"

