#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32740"
msgid "Provider modules"
msgstr "Moduli provider"

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32741"
msgid "{0} ({1})"
msgstr "{0} ({1})"

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32742"
msgid "Set {0} as the default sync provider? This replaces the current sync selections and clears features it does not support. Ratings and scrobbling are configured separately."
msgstr "Impostare {0} come provider di sincronizzazione predefinito? Questa operazione sostituirà le selezioni di sincronizzazione attuali e rimuoverà le funzionalità non supportate. Le valutazioni e lo scrobbling vengono configurati separatamente."

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32743"
msgid "Enable {0} as a ratings provider?"
msgstr "Attivare {0} come provider delle valutazioni?"

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32744"
msgid "Enable scrobbling with {0}?"
msgstr "Attivare lo scrobbling con {0}?"

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32745"
msgid "Are you sure you want to disable {0}? The module and its features will be unavailable."
msgstr "Confermi di voler disattivare {0}? Il modulo e le relative funzionalità non saranno più disponibili."

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32746"
msgid "Disabling this module will remove it from:\n{0}"
msgstr "La disattivazione di questo modulo lo rimuoverà da:\n{0}"

#: /resources/tmdbhelper/lib/script/sync/provider_errors.py
msgctxt "#32747"
msgid "Provider module unavailable"
msgstr "Modulo del provider non disponibile"

#: /resources/tmdbhelper/lib/script/sync/provider_errors.py
msgctxt "#32748"
msgid "The {0} module could not be loaded and its features are temporarily unavailable. Update the module to the latest version and try again. Your settings and synced data have been kept."
msgstr "Impossibile caricare il modulo {0} e le relative funzionalità sono temporaneamente non disponibili. Aggiorna il modulo all'ultima versione e riprova. Le tue impostazioni e i dati sincronizzati sono stati conservati."

#: /resources/settings.xml
msgctxt "#32749"
msgid "Trakt settings"
msgstr "Impostazioni di Trakt"

#: /resources/settings.xml
msgctxt "#32750"
msgid "Configure Trakt list caching, genre icons, and next-episode calendar checks."
msgstr "Configura la memorizzazione nella cache degli elenchi Trakt, le icone dei generi e i controlli del calendario per i prossimi episodi."

#: /resources/settings.xml
msgctxt "#32751"
msgid "Poster image quality"
msgstr "Qualità delle immagini dei poster"

#: /resources/settings.xml
msgctxt "#32752"
msgid "Fanart image quality"
msgstr "Qualità delle immagini fanart"

#: /resources/settings.xml
msgctxt "#32754"
msgid "Choose the resolution of TMDb posters and actor portraits, or use the default image quality setting."
msgstr "Scegli la risoluzione dei poster e dei ritratti degli attori di TMDb oppure utilizza l'impostazione predefinita della qualità delle immagini."

#: /resources/settings.xml
msgctxt "#32755"
msgid "Choose the resolution of TMDb fanart, landscape, and extra fanart, or use the default image quality setting."
msgstr "Scegli la risoluzione delle fanart, delle immagini panoramiche e delle fanart aggiuntive di TMDb oppure utilizza l'impostazione predefinita della qualità delle immagini."

#: /resources/settings.xml
msgctxt "#32756"
msgid "TMDb account"
msgstr "Account TMDb"

#: /resources/settings.xml
msgctxt "#32757"
msgid "Sign in to your TMDb account using a web browser or QR code."
msgstr "Accedi al tuo account TMDb tramite un browser web o un codice QR."

#: /resources/settings.xml
msgctxt "#32758"
msgid "Sign out of your TMDb account and remove the saved authentication token."
msgstr "Esci dal tuo account TMDb e rimuovi il token di autenticazione salvato."

#: /resources/settings.xml
msgctxt "#32759"
msgid "Basic"
msgstr "Base"

#: /resources/settings.xml
msgctxt "#32760"
msgid "Detailed"
msgstr "Dettagliata"

#: /resources/settings.xml
msgctxt "#32761"
msgid "Show expired widget lists for up to"
msgstr "Mostra gli elenchi scaduti dei widget fino a"

#: /resources/settings.xml
msgctxt "#32762"
msgid "When a widget's TMDb list is older than its normal 6 hour cache, show the saved list straight away and download the new list after the widget has loaded. The new list appears the next time Kodi reloads the widget. Lists for today, such as Airing Today, always wait for new data. Off waits for new data every time."
msgstr "Quando un elenco TMDb di un widget supera il normale periodo di memorizzazione nella cache di 6 ore, mostra subito l'elenco salvato e scarica quello aggiornato dopo il caricamento del widget. Il nuovo elenco verrà visualizzato al successivo aggiornamento del widget da parte di Kodi. Gli elenchi relativi al giorno corrente, come In onda oggi, attendono sempre i nuovi dati. Con l'opzione Disattivato, vengono attesi i nuovi dati a ogni caricamento."

#: /resources/settings.xml
msgctxt "#32763"
msgid "Off"
msgstr "Disattivato"

