#: /resources/settings.xml
msgctxt "#32001"
msgid "OMDb key"
msgstr "OMDb 密钥"

# "MPAA rating prefix" 通常指美国电影协会分级前缀（例如 Rated: PG-13 中的 Rated: 部分）
#: /resources/settings.xml
