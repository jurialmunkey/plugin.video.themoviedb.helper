msgstr "A rota "{0}" não está disponível no TMDbHelper. Ele pode estar disponível no módulo de sincronização {1}. Instalar ou ativar este módulo?"

#: /resources/settings.xml
msgctxt "#32581"
msgid "Ratings providers"
msgstr "Provedores de avaliações"

#: /resources/settings.xml
msgctxt "#32582"
msgid "Choose which installed ratings providers to use. Existing cached ratings are retained."
msgstr "Escolha quais provedores de avaliações instalados serão usados. As avaliações em cache existentes são mantidas."

