#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32740"
msgid "Provider modules"
msgstr "Módulos de provedores"

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32741"
msgid "{0} ({1})"
msgstr "{0} ({1})"

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32742"
msgid "Set {0} as the default sync provider? This replaces the current sync selections and clears features it does not support. Ratings and scrobbling are configured separately."
msgstr "Definir {0} como o provedor de sincronização padrão? Isso substitui as seleções de sincronização atuais e limpa os recursos que ele não oferece suporte. Avaliações e scrobbling são configurados separadamente."

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32743"
msgid "Enable {0} as a ratings provider?"
msgstr "Ativar {0} como provedor de avaliações?"

#: /resources/tmdbhelper/lib/script/sync/provider_manager_features.py
msgctxt "#32744"
msgid "Enable scrobbling with {0}?"
msgstr "Ativar o scrobbling com {0}?"

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32745"
msgid "Are you sure you want to disable {0}? The module and its features will be unavailable."
msgstr "Tem certeza de que deseja desativar {0}? O módulo e seus recursos ficarão indisponíveis."

#: /resources/tmdbhelper/lib/script/sync/provider_manager.py
msgctxt "#32746"
msgid "Disabling this module will remove it from:\n{0}"
msgstr "Desativar este módulo o removerá de:\n{0}"

#: /resources/tmdbhelper/lib/script/sync/provider_errors.py
msgctxt "#32747"
msgid "Provider module unavailable"
msgstr "Módulo de provedor indisponível"

#: /resources/tmdbhelper/lib/script/sync/provider_errors.py
msgctxt "#32748"
msgid "The {0} module could not be loaded and its features are temporarily unavailable. Update the module to the latest version and try again. Your settings and synced data have been kept."
msgstr "O módulo {0} não pôde ser carregado e seus recursos estão temporariamente indisponíveis. Atualize o módulo para a versão mais recente e tente novamente. Suas configurações e dados sincronizados foram mantidos."

#: /resources/settings.xml
msgctxt "#32749"
msgid "Trakt settings"
msgstr "Configurações do Trakt"

#: /resources/settings.xml
msgctxt "#32750"
msgid "Configure Trakt list caching, genre icons, and next-episode calendar checks."
msgstr "Configure o cache de listas do Trakt, os ícones de gêneros e as verificações de calendário do próximo episódio."

#: /resources/settings.xml
msgctxt "#32751"
msgid "Poster image quality"
msgstr "Qualidade da imagem do pôster"

#: /resources/settings.xml
msgctxt "#32752"
msgid "Fanart image quality"
msgstr "Qualidade da imagem de fanart"

#: /resources/settings.xml
msgctxt "#32754"
msgid "Choose the resolution of TMDb posters and actor portraits, or use the default image quality setting."
msgstr "Escolha a resolução dos pôsteres e retratos de atores do TMDb, ou use a configuração de qualidade de imagem padrão."

#: /resources/settings.xml
msgctxt "#32755"
msgid "Choose the resolution of TMDb fanart, landscape, and extra fanart, or use the default image quality setting."
msgstr "Escolha a resolução do fanart, das imagens em paisagem e do fanart extra do TMDb, ou use a configuração de qualidade de imagem padrão."

#: /resources/settings.xml
msgctxt "#32756"
msgid "TMDb account"
msgstr "Conta do TMDb"

#: /resources/settings.xml
msgctxt "#32757"
msgid "Sign in to your TMDb account using a web browser or QR code."
msgstr "Entre na sua conta do TMDb usando um navegador da web ou um código QR."

#: /resources/settings.xml
msgctxt "#32758"
msgid "Sign out of your TMDb account and remove the saved authentication token."
msgstr "Saia da sua conta do TMDb e remova o token de autenticação salvo."

#: /resources/settings.xml
msgctxt "#32759"
msgid "Basic"
msgstr "Básico"

#: /resources/settings.xml
msgctxt "#32760"
msgid "Detailed"
msgstr "Detalhado"

#: /resources/settings.xml
msgctxt "#32761"
msgid "Show expired widget lists for up to"
msgstr "Mostrar listas de widgets expirados por até"

#: /resources/settings.xml
msgctxt "#32762"
msgid "When a widget's TMDb list is older than its normal 6 hour cache, show the saved list straight away and download the new list after the widget has loaded. The new list appears the next time Kodi reloads the widget. Lists for today, such as Airing Today, always wait for new data. Off waits for new data every time."
msgstr "Quando a lista do TMDb de um widget for mais antiga do que seu cache normal de 6 horas, mostre a lista salva imediatamente e baixe a nova lista após o carregamento do widget. A nova lista aparece na próxima vez que o Kodi recarregar o widget. As listas de hoje, como "Em exibição hoje", sempre aguardam novos dados. Desativado espera por novos dados todas as vezes."

#: /resources/settings.xml
msgctxt "#32763"
msgid "Off"
msgstr "Desligado"

