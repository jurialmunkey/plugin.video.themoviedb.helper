msgid "Enabled"
msgstr "Habilitado"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32585"
msgid "Disabled"
msgstr "Desabilitado"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32586"
msgid "Move up"
msgstr "Mover para cima"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32587"
msgid "Move down"
msgstr "Mover para baixo"

#: /resources/tmdbhelper/lib/script/ratings/providers.py
msgctxt "#32588"
msgid "No ratings providers are installed."
msgstr "Nenhum provedor de avaliações está instalado."

#: /resources/settings.xml
msgctxt "#32591"
msgid "Provider priority"
msgstr "Prioridade do provedor"

#: /resources/settings.xml
msgctxt "#32592"
msgid "Order ratings providers from highest to lowest priority. Existing cached ratings are retained."
msgstr "Ordene os provedores de avaliações da maior para a menor prioridade. As avaliações em cache existentes são mantidas."

#: /resources/settings.xml /resources/tmdbhelper/lib/player/dialog/episode_groups.py
msgctxt "#32593"
msgid "Episode numbering"
msgstr "Numeração de episódios"

#: /resources/settings.xml /resources/tmdbhelper/lib/player/dialog/episode_groups.py
msgctxt "#32594"
msgid "Default"
msgstr "Padrão"

#: /resources/settings.xml
msgctxt "#32595"
msgid "Select"
msgstr "Selecionar"

#: /resources/settings.xml
msgctxt "#32596"
msgid "Group"
msgstr "Grupo"

#: /resources/settings.xml
msgctxt "#32597"
msgid "Use TMDb numbers, ask for a group, or use the current group. Individual players can override this choice."
msgstr "Use os números do TMDb, peça um grupo ou use o grupo atual. Os reprodutores individuais podem substituir essa escolha."

#: /resources/settings.xml
msgctxt "#32598"
msgid "Statistics"
msgstr "Estatísticas"

#: /resources/settings.xml
msgctxt "#32599"
msgid "Choose providers to receive playback activity. Clear all selections to disable scrobbling."
msgstr "Escolha os provedores para receber a atividade de reprodução. Limpe todas as seleções para desativar o scrobbling."

#: /resources/tmdbhelper/lib/items/directories/base/basedir_sync.py
msgctxt "#32600"
msgid "Currently Watching"
msgstr "Assistindo no Momento"

#: /resources/tmdbhelper/lib/items/directories/base/basedir_sync.py
msgctxt "#32602"
msgid "Your Next Movies"
msgstr "Seus Próximos Filmes"

#: /resources/settings.xml
msgctxt "#32603"
msgid "Update collections"
msgstr "Atualizar coleções"

#: /resources/settings.xml
msgctxt "#32604"
msgid "Discover new movie collections daily and refresh older ones for Your Next Movies after its first use."
msgstr "Descubra novas coleções de filmes todos os dias e atualize as mais antigas para Seus Próximos Filmes após o primeiro uso."

#: /resources/settings.xml
msgctxt "#32605"
msgid "Daily request limit"
msgstr "Limite diário de solicitações"

#: /resources/settings.xml
msgctxt "#32606"
msgid "Limit daily movie collection requests, including retries. New collections take priority over overdue refreshes."
msgstr "Limite as solicitações diárias de coleta de filmes, incluindo novas tentativas. As novas coleções têm prioridade sobre as atualizações atrasadas."

#: /resources/tmdbhelper/lib/items/directories/sync/mapper_nextmovies.py
msgctxt "#32607"
msgid "Drop collection"
msgstr "Descartar coleção"

#: /resources/settings.xml
msgctxt "#32608"
msgid "Advanced"
msgstr "Avançado"

#: /resources/settings.xml
msgctxt "#32609"
msgid "Include movie releases outside your selected country when filtering TMDb lists."
msgstr "Inclua lançamentos de filmes fora do país selecionado ao filtrar listas do TMDb."

#: /resources/settings.xml
msgctxt "#32610"
msgid "Show authorisation and sync notifications when Kodi starts."
msgstr "Exibir autorização e sincronizar notificações quando o Kodi iniciar."

#: /resources/settings.xml
msgctxt "#32611"
msgid "Show notifications while user data is synchronising."
msgstr "Mostrar notificações enquanto os dados do usuário estão sendo sincronizados."

#: /resources/settings.xml
msgctxt "#32612"
msgid "Show a notification when a service connection fails."
msgstr "Mostrar uma notificação quando uma conexão de serviço falhar."

#: /resources/settings.xml
msgctxt "#32613"
msgid "Show Browse lists in the item context menu."
msgstr "Mostrar navegação de listas no menu de contexto do item."

#: /resources/settings.xml
msgctxt "#32614"
msgid "Show sync actions in the item context menu."
msgstr "Mostrar ações de sincronização no menu de contexto do item."

#: /resources/settings.xml
msgctxt "#32615"
msgid "Show TMDb account actions in the item context menu."
msgstr "Mostrar ações da conta TMDb no menu de contexto do item."

#: /resources/settings.xml
msgctxt "#32616"
msgid "Show Refresh details in the item context menu."
msgstr "Mostrar detalhes de Atualizar no menu de contexto do item."

#: /resources/settings.xml
msgctxt "#32617"
msgid "Show Modify artwork in the item context menu."
msgstr "Mostrar Modificar arte no menu de contexto do item."

#: /resources/settings.xml
msgctxt "#32618"
msgid "Add to library"
msgstr "Adicionar à biblioteca"

#: /resources/settings.xml
msgctxt "#32619"
msgid "Show Add to library in the item context menu."
msgstr "Mostrar "Adicionar à biblioteca" no menu de contexto do item."

#: /resources/settings.xml
msgctxt "#32620"
msgid "Show Add node in the item context menu."
msgstr "Mostrar 'Adicionar nó' no menu de contexto do item."

#: /resources/settings.xml
msgctxt "#32621"
msgid "Show a next-page item in widgets when more results are available."
msgstr "Mostrar um item da próxima página nos widgets quando mais resultados estiverem disponíveis."

#: /resources/settings.xml
msgctxt "#32622"
msgid "Open the episode list directly instead of showing seasons."
msgstr "Abra a lista de episódios diretamente em vez de mostrar as temporadas."

#: /resources/settings.xml
msgctxt "#32623"
msgid "Show the additional Specials season entry."
msgstr "Mostre a entrada adicional da temporada de Especiais."

#: /resources/settings.xml
msgctxt "#32624"
msgid "Show the additional Anticipated season entry."
msgstr "Mostre a entrada de temporada antecipada adicional."

#: /resources/settings.xml
msgctxt "#32625"
msgid "Show the additional episode Groups entry."
msgstr "Mostre a entrada adicional de episódios de Grupos."

#: /resources/settings.xml
msgctxt "#32626"
msgid "Show the additional Up next season entry when signed in to Trakt."
msgstr "Mostrar a entrada adicional da próxima temporada ao entrar no Trakt."

#: /resources/settings.xml
msgctxt "#32627"
msgid "Combine episodes from the same show airing on the same day into one calendar entry."
msgstr "Combine episódios do mesmo programa que vão ao ar no mesmo dia em uma única entrada do calendário."

#: /resources/settings.xml
msgctxt "#32628"
msgid "Open the local TV show from entries in the next-aired library calendar."
msgstr "Abra o programa de TV local a partir das entradas no calendário da biblioteca de próximas exibições."

#: /resources/settings.xml
msgctxt "#32629"
msgid "Choose the artwork used for next-episode thumbnails."
msgstr "Escolha a arte usada para as miniaturas do próximo episódio."

#: /resources/settings.xml
msgctxt "#32630"
msgid "Check the calendar for next episodes. Slower, but more accurate."
msgstr "Consulte o calendário para ver os próximos episódios. Mais lento, mas mais preciso."

#: /resources/settings.xml
msgctxt "#32631"
msgid "Load this many pages per request for basic TMDb lists. Higher values are slower."
msgstr "Carregar este número de páginas por solicitação para listas básicas do TMDb. Valores mais altos são mais lentos."

#: /resources/settings.xml
msgctxt "#32632"
msgid "Load this many pages per request for other basic lists. Higher values are slower."
msgstr "Carregar este número de páginas por solicitação para outras listas básicas. Valores mais altos são mais lentos."

#: /resources/settings.xml
msgctxt "#32633"
msgid "Load this many pages per request for synced database lists. Higher values are slower."
msgstr "Carregue este número de páginas por solicitação para listas de bancos de dados sincronizados. Valores mais altos são mais lentos."

#: /resources/settings.xml
msgctxt "#32634"
msgid "Cache the items in Trakt custom lists you own for 24 hours."
msgstr "Armazene em cache os itens das listas personalizadas do Trakt que são suas por 24 horas."

#: /resources/settings.xml
msgctxt "#32635"
msgid "Choose the default resolution of artwork downloaded from TMDb. Poster and fanart settings can override this default."
msgstr "Escolha a resolução padrão das artes baixadas do TMDb. As configurações de pôster e fanart podem substituir esse padrão."

#: /resources/settings.xml
msgctxt "#32636"
msgid "Fetch Fanart.tv artwork for plugin items. Additional lookups are slower."
msgstr "Obter artes do Fanart.tv para itens do plugin. As pesquisas adicionais são mais lentas."

#: /resources/settings.xml
msgctxt "#32637"
msgid "Prefer Fanart.tv artwork over TMDb artwork when both are available."
msgstr "Dar preferência às artes do Fanart.tv em vez das artes do TMDb quando ambas estiverem disponíveis."

#: /resources/settings.xml
msgctxt "#32638"
msgid "Prefer artwork in your selected language when choosing images."
msgstr "Ao escolher imagens, prefira artes no idioma selecionado."

#: /resources/settings.xml
msgctxt "#32639"
msgid "Choose the folder containing custom icons for TMDb genres."
msgstr "Escolha a pasta que contém os ícones personalizados para os gêneros do TMDb."

#: /resources/settings.xml
msgctxt "#32640"
msgid "Choose the folder containing custom icons for Trakt genres."
msgstr "Escolha a pasta que contém os ícones personalizados para os gêneros do Trakt."

#: /resources/settings.xml
msgctxt "#32641"
msgid "Choose the folder containing custom TMDb watch-provider icons."
msgstr "Escolha a pasta que contém os ícones personalizados dos provedores de streaming do TMDb."

#: /resources/settings.xml
msgctxt "#32642"
msgid "Retrieve background artwork for genre entries."
msgstr "Obter artes visuais de fundo para entradas de gêneros."

#: /resources/settings.xml
msgctxt "#32643"
msgid "Retrieve background artwork for watch-provider entries."
msgstr "Recuperar a arte de fundo para entradas do provedor de observação."

#: /resources/settings.xml
msgctxt "#32644"
msgid "Choose the default player used for movies."
msgstr "Escolha o reprodutor padrão usado para filmes."

#: /resources/settings.xml
msgctxt "#32645"
msgid "Choose the default player used for TV episodes."
msgstr "Escolha o reprodutor padrão usado para episódios de TV."

#: /resources/settings.xml
msgctxt "#32646"
msgid "Automatically play using available providers instead of asking for a player."
msgstr "Reproduzir automaticamente usando provedores disponíveis em vez de pedir um reprodutor."

#: /resources/settings.xml
msgctxt "#32647"
msgid "Choose how playback uses files already in the Kodi library."
msgstr "Escolha como a reprodução usa arquivos já presentes na biblioteca do Kodi."

#: /resources/settings.xml
msgctxt "#32648"
msgid "Show one player entry per plugin instead of separate entries for each player."
msgstr "Mostrar uma entrada de reprodutor por plugin em vez de entradas separadas para cada reprodutor."

#: /resources/settings.xml
msgctxt "#32649"
msgid "Include player definitions supplied with the add-on."
msgstr "Inclua as definições de reprodutor fornecidas com o complemento."

#: /resources/settings.xml
msgctxt "#32650"
msgid "Download player definitions from the URL you provide."
msgstr "Baixe as definições do reprodutor da URL que você fornecer."

#: /resources/settings.xml
msgctxt "#32651"
msgid "Choose and customise the available player definitions."
msgstr "Escolha e personalize as definições de reprodutor disponíveis."

#: /resources/settings.xml
msgctxt "#32652"
msgid "Ask for a TMDb rating after watching an item when signed in to TMDb."
msgstr "Solicite uma classificação do TMDb depois de assistir a um item quando estiver conectado ao TMDb."

#: /resources/settings.xml
msgctxt "#32653"
msgid "Movies folder"
msgstr "Pasta de filmes"

#: /resources/settings.xml
msgctxt "#32654"
msgid "Choose where movie STRM and NFO files are created for the Kodi library."
msgstr "Escolha onde os arquivos STRM e NFO de filmes são criados para a biblioteca do Kodi."

#: /resources/settings.xml
msgctxt "#32655"
msgid "Choose where TV show STRM and NFO files are created for the Kodi library."
msgstr "Escolha onde os arquivos STRM e NFO de programas de TV são criados para a biblioteca do Kodi."

#: /resources/settings.xml
msgctxt "#32656"
msgid "Scan the Kodi library after adding items through TMDbHelper."
msgstr "Verifique a biblioteca do Kodi após adicionar itens por meio do TMDbHelper."

#: /resources/settings.xml
msgctxt "#32657"
msgid "Automatically update library exports and add new or missing episodes."
msgstr "Atualize automaticamente as exportações da biblioteca e adicione episódios novos ou ausentes."

#: /resources/settings.xml
msgctxt "#32658"
msgid "Choose the hour for the daily library update."
msgstr "Escolha a hora para a atualização diária da biblioteca."

#: /resources/settings.xml
msgctxt "#32659"
msgid "Choose the lists used to add items during automatic library updates."
msgstr "Escolha as listas usadas para adicionar itens durante as atualizações automáticas da biblioteca."

#: /resources/settings.xml
msgctxt "#32660"
msgid "Store the source-list identifiers used by automatic library updates."
msgstr "Armazene os identificadores da lista de fontes usados pelas atualizações automáticas da biblioteca."

#: /resources/settings.xml
msgctxt "#32661"
msgid "Choose which library exports to update now."
msgstr "Escolha quais exportações de biblioteca atualizar agora."

#: /resources/settings.xml
msgctxt "#32662"
msgid "Choose whether to add local Kodi library details to items."
msgstr "Escolha se deseja adicionar detalhes da biblioteca local do Kodi aos itens."

#: /resources/settings.xml
msgctxt "#32663"
msgid "Refresh TMDbHelper's cached details from the local Kodi library."
msgstr "Atualize os detalhes armazenados em cache do TMDbHelper a partir da biblioteca local do Kodi."

#: /resources/settings.xml
msgctxt "#32664"
msgid "Skip checks after creating library folders on systems that report new folders slowly."
msgstr "Pular verificações após criar pastas da biblioteca em sistemas que relatam novas pastas lentamente."

#: /resources/settings.xml
msgctxt "#32665"
msgid "Use movie-tmdbhelper.nfo or tvshow-tmdbhelper.nfo instead of the standard NFO filename."
msgstr "Use movie-tmdbhelper.nfo ou tvshow-tmdbhelper.nfo em vez do nome de arquivo NFO padrão."

#: /resources/settings.xml
msgctxt "#32666"
msgid "Connect your Trakt account to TMDbHelper."
msgstr "Conecte sua conta do Trakt ao TMDbHelper."

#: /resources/settings.xml
msgctxt "#32667"
msgid "Disconnect your Trakt account from TMDbHelper."
msgstr "Desconecte sua conta do Trakt do TMDbHelper."

#: /resources/settings.xml
msgctxt "#32668"
msgid "Open settings"
msgstr "Abrir configurações"

#: /resources/settings.xml
msgctxt "#32669"
msgid "Install MDbList support if needed, then open its provider settings."
msgstr "Instale o suporte ao MDbList, se necessário, e abra as configurações do provedor."

#: /resources/settings.xml
msgctxt "#32671"
msgid "Enter your OMDb API key for additional ratings and metadata."
msgstr "Insira sua chave de API do OMDb para obter avaliações e metadados adicionais."

#: /resources/settings.xml
msgctxt "#32672"
msgid "Enter your RatingPosterDB API key for posters with ratings."
msgstr "Insira sua chave de API do RatingPosterDB para obter pôsteres com avaliações."

#: /resources/settings.xml
msgctxt "#32674"
msgid "Enter your Fanart.tv client key for artwork lookups."
msgstr "Insira sua chave de cliente do Fanart.tv para consultas de arte."

#: /resources/settings.xml
msgctxt "#32675"
msgid "Configure providers"
msgstr "Configurar provedores"

#: /resources/settings.xml
msgctxt "#32676"
msgid "Store the selected ratings providers and their priority order."
msgstr "Armazena os provedores de avaliações selecionados e sua ordem de prioridade."

#: /resources/settings.xml
msgctxt "#32677"
msgid "Choose a watchlist provider, install one, or select None to disable watchlist lists."
msgstr "Escolha um provedor de lista, instale um ou selecione Nenhum para desativar as listas."

#: /resources/settings.xml
msgctxt "#32678"
msgid "Choose a collection provider, install one, or select None to disable collection lists."
msgstr "Escolha um provedor de coleção, instale um ou selecione Nenhum para desativar as listas de coleção."

#: /resources/settings.xml
msgctxt "#32679"
msgid "Choose a statistics provider, install one, or select None to disable statistics lists."
msgstr "Escolha um provedor de estatísticas, instale um ou selecione Nenhum para desativar as listas de estatísticas."

#: /resources/settings.xml
msgctxt "#32680"
msgid "Choose a supported sync provider to install or enable."
msgstr "Escolha um provedor de sincronização compatível para instalar ou ativar."

#: /resources/settings.xml
msgctxt "#32681"
msgid "Synchronise watched status and resume points with the selected history provider."
msgstr "Sincroniza o status de assistido e os pontos de retomada com o provedor de histórico selecionado."

#: /resources/settings.xml
msgctxt "#32682"
msgid "Clear cached synced user data so it can be downloaded again."
msgstr "Limpa os dados de usuário sincronizados em cache para que possam ser baixados novamente."

#: /resources/settings.xml
msgctxt "#32683"
msgid "Choose which watch providers are included in provider data lookups."
msgstr "Escolha quais provedores de exibição são incluídos nas consultas de dados de provedores."

#: /resources/settings.xml
msgctxt "#32684"
msgid "Allow the image monitor to fetch artwork from online sources."
msgstr "Permite que o monitor de imagens busque artes em fontes online."

#: /resources/settings.xml
msgctxt "#32685"
msgid "Allow the details monitor to fetch ratings from online sources."
msgstr "Permite que o monitor de detalhes busque avaliações em fontes online."

#: /resources/settings.xml
msgctxt "#32686"
msgid "Use TMDbHelper artwork instead of the clearlogo supplied by the playback monitor."
msgstr "Usa a arte do TMDbHelper em vez do clearlogo fornecido pelo monitor de reprodução."

#: /resources/settings.xml
msgctxt "#32687"
msgid "Set how long the dummy video plays when resolving playback, in seconds."
msgstr "Define por quanto tempo, em segundos, o vídeo fictício é reproduzido ao resolver a reprodução."

#: /resources/settings.xml
msgctxt "#32688"
msgid "Set the delay after the dummy video stops before playback continues, in seconds."
msgstr "Define o atraso, em segundos, após a parada do vídeo fictício antes de a reprodução continuar."

#: /resources/settings.xml
msgctxt "#32689"
msgid "Restrict URL resolving to library STRM playback."
msgstr "Restringe a resolução de URLs à reprodução de STRM da biblioteca."

#: /resources/settings.xml
msgctxt "#32690"
msgid "Refresh cached Kodi library details when building the player list."
msgstr "Atualiza os detalhes em cache da biblioteca do Kodi ao construir a lista de reprodutores."

#: /resources/settings.xml
msgctxt "#32691"
msgid "Use the alternative TMDb API address for network compatibility."
msgstr "Usa o endereço alternativo da API do TMDb para compatibilidade de rede."

#: /resources/settings.xml
msgctxt "#32692"
msgid "Set the maximum number of concurrent threads. Zero means unlimited."
msgstr "Define o número máximo de threads simultâneas. Zero significa ilimitado."

#: /resources/settings.xml
msgctxt "#32693"
msgid "Choose a custom location for TMDbHelper cache databases."
msgstr "Escolha um local personalizado para os bancos de dados de cache do TMDbHelper."

#: /resources/settings.xml
msgctxt "#32694"
msgid "Choose a custom location for cached images."
msgstr "Escolha um local personalizado para as imagens em cache."

#: /resources/settings.xml
msgctxt "#32695"
msgid "Delete cached TMDb list details for troubleshooting. Lists will be downloaded again when needed."
msgstr "Exclui os detalhes das listas do TMDb em cache para solução de problemas. As listas serão baixadas novamente quando necessário."

#: /resources/settings.xml
msgctxt "#32696"
msgid "Write additional diagnostic information to the Kodi log."
msgstr "Grava informações de diagnóstico adicionais no log do Kodi."

#: /resources/settings.xml
msgctxt "#32697"
msgid "Disabled collects no timer reports. Basic collects directory timer reports. Detailed also collects item detail timer reports."
msgstr "Desativado não coleta relatórios de tempo. Básico coleta relatórios de tempo dos diretórios. Detalhado também coleta relatórios de tempo dos detalhes dos itens."

#: /resources/settings.xml
msgctxt "#32698"
msgid "Run a TMDb request and write its response to the Kodi log."
msgstr "Executa uma solicitação ao TMDb e grava a resposta no log do Kodi."

#: /resources/settings.xml
msgctxt "#32699"
msgid "Run a Trakt request and write its response to the Kodi log."
msgstr "Executa uma solicitação ao Trakt e grava a resposta no log do Kodi."

#: /resources/settings.xml
msgctxt "#32701"
msgid "Store the TMDb account authentication token used by TMDbHelper."
msgstr "Armazena o token de autenticação da conta do TMDb usado pelo TMDbHelper."

#: /resources/settings.xml
msgctxt "#32702"
msgid "Store the Trakt account authentication token used by TMDbHelper."
msgstr "Armazena o token de autenticação da conta do Trakt usado pelo TMDbHelper."

#: /resources/settings.xml
msgctxt "#32703"
msgid "Allow other plugins to access the saved OMDb API key."
msgstr "Permite que outros plugins acessem a chave de API do OMDb salva."

#: /resources/settings.xml
msgctxt "#32704"
msgid "Allow other plugins to access the saved Fanart.tv client key."
msgstr "Permite que outros plugins acessem a chave de cliente do Fanart.tv salva."

#: /resources/settings.xml
msgctxt "#32706"
msgid "Allow other plugins to access the saved TMDb account token."
msgstr "Permite que outros plugins acessem o token da conta do TMDb salvo."

#: /resources/settings.xml
msgctxt "#32707"
msgid "Allow other plugins to access the saved Trakt account token."
msgstr "Permite que outros plugins acessem o token da conta do Trakt salvo."

